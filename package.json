{
  "name": "danferg.com",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.8.2"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check && npm test",
    "article:publish": "node --env-file-if-exists=.env scripts/article-publish.mjs",
    "audit:build": "node scripts/audit-build.mjs",
    "generate:og": "node scripts/generate-og.mjs",
    "prebuild": "npm run generate:og",
    "build": "astro build",
    "postbuild": "npx pagefind --site dist && npm run audit:build",
    "preview": "astro preview",
    "test": "node --test tests/rehype-mermaid-blocks.test.mjs tests/article-publishing.test.mjs",
    "astro": "astro",
    "search:index": "npx pagefind --site dist"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "astro-robots-txt": "^1.0.0",
    "pagefind": "^1.5.2",
    "parse5": "^8.0.1",
    "posthog-js": "^1.434.15",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@paper-design/shaders": "0.0.81",
    "mermaid": "^11.17.2",
    "motion": "^13.4.4",
    "reading-time": "^1.5.0",
    "sharp": "^0.35.4"
  }
}
