# Analytics. Set PUBLIC_POSTHOG_PROJECT_TOKEN in Vercel (Production and Preview)
# too: it is baked into the HTML at build time. Production sends events through
# the /relay rewrite in vercel.json; PUBLIC_POSTHOG_HOST is only used by the dev
# server and defaults to https://us.i.posthog.com.
PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Required only when generating an article narration.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# Optional article-audio defaults.
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_64
