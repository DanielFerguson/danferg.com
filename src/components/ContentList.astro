---
export interface ContentItem {
  title: string;
  description: string;
  href: string;
  meta: string;
  detail?: string;
  external?: boolean;
  /** Tag chips; also written to data-tags for client-side filtering. */
  tags?: Array<{ id: string; label: string; href: string }>;
  /** Series id, written to data-series for filtering. */
  series?: string;
}

interface Props {
  items: ContentItem[];
  orderedLabel: string;
}

const { items, orderedLabel } = Astro.props;
---

<ol class="content-list" aria-label={orderedLabel} data-motion-group>
  {
    items.map((item) => (
      <li
        data-motion-item
        data-tags={item.tags?.map((tag) => tag.id).join(" ") || undefined}
        data-series={item.series || undefined}
      >
        <a
          href={item.href}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noopener noreferrer" : undefined}
          data-motion-interactive
          data-astro-prefetch={item.external ? undefined : "hover"}
        >
          <span class="content-list__copy">
            <strong>{item.title}</strong>
            <span class="content-list__desc">{item.description}</span>
            {item.tags && item.tags.length > 0 && (
              <span class="content-list__tags" aria-label="Tags">
                {item.tags.map((tag) => (
                  <span class="content-list__tag" data-tag={tag.id}>
                    {tag.label}
                  </span>
                ))}
              </span>
            )}
          </span>
          <span class="content-list__meta">
            <span>{item.meta}</span>
            {item.detail && <span class="content-list__detail">{item.detail}</span>}
          </span>
          <span class="content-list__arrow" aria-hidden="true" data-motion-arrow>
            {item.external ? "↗" : "→"}
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .content-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  li {
    border-bottom: 1px solid var(--line);
  }

  a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(8.5rem, auto) 1.25rem;
    gap: 1.25rem;
    align-items: start;
    padding: 1.35rem 0.25rem;
    color: var(--ink);
    text-decoration: none;
    transition: background-color 140ms ease;
  }

  a:is(:hover, :focus-visible) strong,
  a:is(:hover, :focus-visible) .content-list__arrow {
    color: var(--signal);
  }

  .content-list__copy {
    display: grid;
    gap: 0.35rem;
  }

  .content-list__copy strong {
    font-size: clamp(1.02rem, 1.5vw, 1.15rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
    transition: color 140ms ease;
  }

  .content-list__desc {
    max-width: 60ch;
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .content-list__meta {
    display: grid;
    gap: 0.2rem;
    justify-items: end;
    padding-top: 0.15rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.45;
    white-space: nowrap;
  }

  .content-list__detail {
    color: var(--ink-muted);
    opacity: 0.85;
  }

  .content-list__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }

  .content-list__tag {
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.5;
  }

  li[hidden] {
    display: none;
  }

  .content-list__arrow {
    justify-self: end;
    padding-top: 0.1rem;
    color: var(--ink-muted);
    font-size: 0.95rem;
    transition: color 140ms ease;
  }

  @media (max-width: 720px) {
    a {
      grid-template-columns: minmax(0, 1fr) 1.25rem;
      gap: 0.65rem 1rem;
      padding: 1.15rem 0;
    }

    .content-list__meta {
      grid-column: 1;
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem 0.85rem;
      justify-items: start;
      padding-top: 0;
    }

    .content-list__arrow {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
