---
// Imported as a URL so Vite fingerprints it for long-lived caching without
// re-encoding: the artwork is a four-colour dither that resizing or lossy
// formats would smear, and the shader maps it back onto that palette.
import portraitUrl from "../assets/images/dan-dark.png?url";
---

<figure
  class="hero-portrait"
  data-hero-portrait
  data-hero-shader-state="fallback"
>
  <svg
    class="hero-portrait__filters"
    width="0"
    height="0"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <!-- The source artwork has four flat colours. This matrix maps its dark
           palette exactly to the corresponding light palette for fallbacks. -->
      <filter
        id="hero-portrait-light-palette"
        color-interpolation-filters="sRGB"
      >
        <feColorMatrix
          type="matrix"
          values="
            -1.10921766 0 1.52904725 0 -0.33579077
            -0.41914106 0 0.64575265 0 -0.09475352
            -0.51828901 1 1.03382391 0 -0.05448682
            0 0 0 1 0
          "
        />
      </filter>
    </defs>
  </svg>
  <script is:inline>
    (() => {
      const portrait = document.currentScript?.parentElement;
      const staticMode =
        new URLSearchParams(window.location.search).get("hero") === "static";
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const saveData = navigator.connection?.saveData === true;
      // Beside the headline (wide layouts) the portrait starts on the shader's
      // backdrop so the pixel reveal is its entrance. Stacked below the fold,
      // the static image stays visible until the shader is ready to take over.
      const besideHeadline = window.matchMedia("(min-width: 901px)").matches;

      if (
        portrait instanceof HTMLElement &&
        portrait.matches("[data-hero-portrait]") &&
        !staticMode &&
        !reducedMotion &&
        !saveData &&
        besideHeadline
      ) {
        portrait.dataset.heroShaderState = "loading";
      }
    })();
  </script>
  <img
    class="hero-portrait__image"
    src={portraitUrl}
    alt="Dan Ferg in conversation at the CivVic and VicHealth Showcase"
    width="2280"
    height="1283"
  />
</figure>

<script>
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  );
  const staticMode =
    new URLSearchParams(window.location.search).get("hero") === "static";
  const disposers = new Set<() => void>();

  const saveData =
    (navigator as Navigator & { connection?: { saveData?: boolean } })
      .connection?.saveData === true;

  const whenIdle = (callback: () => void) => {
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(callback, { timeout: 800 });
    } else {
      setTimeout(callback, 200);
    }
  };

  const enhance = async (portrait: HTMLElement) => {
    try {
      const { enhanceHeroPortrait } = await import(
        "../scripts/hero-portrait-shader"
      );
      const dispose = await enhanceHeroPortrait(portrait);
      if (dispose) disposers.add(dispose);
    } catch {
      portrait.dataset.heroShaderState = "fallback";
    }
  };

  /**
   * The WebGL set-up is the most expensive work on the homepage, so it waits
   * for the portrait to be in view and for the main thread to be idle.
   */
  const startExperiment = () => {
    if (staticMode || prefersReducedMotion.matches || saveData) return;

    const portraits = Array.from(
      document.querySelectorAll<HTMLElement>("[data-hero-portrait]"),
    ).filter((portrait) =>
      ["fallback", "loading"].includes(
        portrait.dataset.heroShaderState ?? "fallback",
      ),
    );

    for (const portrait of portraits) {
      if (!("IntersectionObserver" in window)) {
        whenIdle(() => void enhance(portrait));
        continue;
      }

      // Beside the headline it is already on screen behind the backdrop, so
      // start as soon as possible. Stacked below the fold, the static image
      // stays up until a good part of the portrait is visible, so the reveal
      // plays where it can be seen rather than off-screen during page load.
      const besideHeadline = portrait.dataset.heroShaderState === "loading";
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          whenIdle(() => void enhance(portrait));
        },
        besideHeadline
          ? { rootMargin: "200px 0px" }
          : { threshold: 0.3 },
      );
      observer.observe(portrait);
    }
  };

  startExperiment();

  window.addEventListener(
    "pagehide",
    () => {
      disposers.forEach((dispose) => dispose());
      disposers.clear();
    },
    { once: true },
  );
</script>

<style>
  .hero-portrait__filters {
    position: absolute;
    pointer-events: none;
  }

  .hero-portrait[data-hero-portrait][data-hero-shader-state="loading"],
  .hero-portrait[data-hero-portrait][data-hero-shader-state="ready"] {
    background: rgb(0 12 56);
  }

  .hero-portrait[data-hero-shader-state="loading"]
    :global(.hero-portrait__image),
  .hero-portrait[data-hero-shader-state="ready"]
    :global(.hero-portrait__image) {
    opacity: 0;
  }

  .hero-portrait :global(canvas.hero-portrait__shader) {
    z-index: 2;
    opacity: 0;
    pointer-events: none;
  }

  .hero-portrait[data-hero-shader-state="ready"]
    :global(canvas.hero-portrait__shader) {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-portrait :global(canvas.hero-portrait__shader) {
      display: none;
    }
  }
</style>
