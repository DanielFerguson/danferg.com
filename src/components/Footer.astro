---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-container footer-frame">
    <div class="footer-grid" data-motion-group>
      <div class="footer-about" data-motion-item>
        <a class="footer-wordmark" href="/">
          <img
            class="footer-wordmark__wave"
            src="/images/wave.png"
            alt=""
            width="20"
            height="20"
            loading="lazy"
            decoding="async"
          />
          <span>Dan Ferg</span>
        </a>
        <p class="footer-note">
          Software builder in Melbourne, Australia. Full-time Head of Innovation
          at Spatial Media, with side projects in civic tech, AI, and cattle
          farming.
        </p>
      </div>

      <div class="footer-col" data-motion-item>
        <p class="footer-label">Pages</p>
        <nav aria-label="Site pages">
          <a href="/projects" data-astro-prefetch="hover">Projects</a>
          <a href="/articles" data-astro-prefetch="hover">Articles</a>
          <a href="/speaking" data-astro-prefetch="hover">Speaking</a>
          <a href="/consulting" data-astro-prefetch="hover">Consulting</a>
          <a href="/about" data-astro-prefetch="hover">About</a>
          <a href="/newsletters" data-astro-prefetch="hover">Newsletters</a>
        </nav>
      </div>

      <div class="footer-col" data-motion-item>
        <p class="footer-label">Elsewhere</p>
        <nav aria-label="Social links">
          <a href="mailto:gday@danferg.com">gday@danferg.com</a>
          <a
            href="https://github.com/danielferguson"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
          <a
            href="https://www.linkedin.com/in/danferg"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>
          <a href="/rss.xml">RSS feed</a>
        </nav>
      </div>
    </div>

    <div class="footer-base">
      <p>© {year} Dan Ferg</p>
      <p>Melbourne, Australia</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    color: var(--ink);
    background: var(--paper);
  }

  .footer-frame {
    border-inline: 1px solid var(--line);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(9rem, 0.7fr) minmax(9rem, 0.7fr);
    gap: clamp(2rem, 5vw, 4rem);
    padding: clamp(2.75rem, 5vw, 4rem) clamp(1.25rem, 4.5vw, 4rem);
  }

  .footer-wordmark {
    display: inline-flex;
    gap: 0.55rem;
    align-items: center;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .footer-wordmark__wave {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .footer-note {
    max-width: 26rem;
    margin: 0.85rem 0 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .footer-label {
    margin: 0 0 0.85rem;
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 550;
  }

  nav {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  nav a {
    color: var(--ink-soft);
    font-size: 0.875rem;
    text-decoration: none;
  }

  nav a:is(:hover, :focus-visible) {
    color: var(--signal);
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    padding: 1.15rem clamp(1.25rem, 4.5vw, 4rem);
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: var(--text-label);
  }

  .footer-base p {
    margin: 0;
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      padding-inline: 1rem;
    }

    .footer-about {
      grid-column: 1 / -1;
    }

    .footer-base {
      padding-inline: 1rem;
    }
  }
</style>
