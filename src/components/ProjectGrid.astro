---
interface ProjectModule {
  url: string;
  frontmatter: {
    title: string;
    description: string;
    highlight?: boolean;
    highlightDiagram?: string;
    period?: string;
    role?: string;
    status?: string;
  };
}

interface Props {
  projects: ProjectModule[];
}

const { projects } = Astro.props as Props;
---

<div class="project-grid" data-motion-group>
  {
    projects.map((project) => {
      const isHighlight = Boolean(project.frontmatter.highlight);

      return (
        <a
          href={project.url}
          class:list={[
            "project-cell",
            { "project-cell--highlight": isHighlight },
          ]}
          data-motion-item
          data-motion-interactive
          data-astro-prefetch="hover"
        >
          <span class="project-cell__top">
            <span class="project-cell__meta">
              {isHighlight && <span class="project-cell__badge">Featured</span>}
              {project.frontmatter.status && (
                <span class="project-cell__status">
                  {project.frontmatter.status}
                </span>
              )}
            </span>
            {project.frontmatter.period && (
              <span class="project-cell__period">
                {project.frontmatter.period}
              </span>
            )}
          </span>

          <strong class="project-cell__title" data-motion-target>
            {project.frontmatter.title}
          </strong>

          <span class="project-cell__description">
            {project.frontmatter.description}
          </span>

          <span class="project-cell__cta" aria-hidden="true">
            Read story <span data-motion-arrow>→</span>
          </span>
        </a>
      );
    })
  }
</div>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .project-cell {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.4rem, 3vw, 2.25rem);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    background: var(--paper);
    text-decoration: none;
    transition: background-color 140ms ease;
  }

  .project-cell:is(:hover, :focus-visible) {
    background: var(--paper-subtle);
  }

  .project-cell:is(:hover, :focus-visible) .project-cell__title,
  .project-cell:is(:hover, :focus-visible) .project-cell__cta {
    color: var(--signal);
  }

  .project-cell--highlight {
    position: relative;
    grid-column: 1 / -1;
    background: linear-gradient(
      125deg,
      color-mix(in srgb, var(--signal-soft) 72%, var(--paper)) 0%,
      color-mix(in srgb, var(--signal-pink-soft) 45%, var(--paper)) 100%
    );
  }

  .project-cell--highlight::before {
    position: absolute;
    top: -1px;
    right: -1px;
    left: -1px;
    height: 2px;
    background: linear-gradient(90deg, var(--signal) 0%, var(--signal-pink) 100%);
    content: "";
  }

  .project-cell--highlight:is(:hover, :focus-visible) {
    background: linear-gradient(
      125deg,
      color-mix(in srgb, var(--signal-soft) 92%, var(--paper)) 0%,
      color-mix(in srgb, var(--signal-pink-soft) 68%, var(--paper)) 100%
    );
  }

  .project-cell__top {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.35rem;
    font-size: var(--text-label);
  }

  .project-cell__meta {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .project-cell__badge {
    padding: 0.12rem 0.55rem;
    border: 1px solid var(--signal-line);
    border-radius: 999px;
    color: var(--signal);
    background: var(--paper);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .project-cell__status {
    color: var(--ink-muted);
    font-size: 0.8125rem;
  }

  .project-cell__period {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .project-cell__title {
    color: var(--ink);
    font-size: clamp(1.3rem, 2.2vw, 1.6rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.025em;
    transition: color 140ms ease;
  }

  .project-cell--highlight .project-cell__title {
    font-size: clamp(1.55rem, 2.8vw, 2rem);
  }

  .project-cell__description {
    max-width: 56ch;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .project-cell__cta {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    margin-top: auto;
    padding-top: 0.65rem;
    color: var(--ink-muted);
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 140ms ease;
  }

  @media (max-width: 760px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    .project-cell {
      padding: 1.35rem 1.15rem;
    }
  }
</style>
