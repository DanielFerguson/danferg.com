---
import ThemeToggle from "./ThemeToggle.astro";
const navigation = [
  { name: "Projects", href: "/projects", section: ["/projects", "/skills"] },
  { name: "Consulting", href: "/consulting", section: ["/consulting"] },
  { name: "Articles", href: "/articles", section: ["/articles", "/newsletters"] },
  { name: "Speaking", href: "/speaking", section: ["/speaking"] },
  { name: "About", href: "/about", section: ["/about"] },
];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentState = (item: (typeof navigation)[number]) => {
  if (currentPath === item.href) return "page";
  return item.section.some((path) => currentPath.startsWith(`${path}/`))
    ? "true"
    : undefined;
};

---

<header class="site-header">
  <div class="signal-bar">
    <div class="site-container signal-bar__inner">
      <p><span aria-hidden="true">■</span> Melbourne, Australia</p>
      <a href="/consulting" data-motion-interactive>Consulting / advisory / speaking <span aria-hidden="true" data-motion-arrow>→</span></a>
    </div>
  </div>

  <div class="site-container nav-shell">
    <a class="wordmark" href="/">
      <span aria-hidden="true">D/F</span>
      <span class="visually-hidden">Dan Ferg — home</span>
    </a>

    <nav aria-label="Main navigation">
      <ul>
        {
          navigation.map((item) => (
            <li><a href={item.href} aria-current={currentState(item)} data-astro-prefetch="hover">{item.name}</a></li>
          ))
        }
      </ul>
    </nav>

    <div class="nav-actions">
      <ThemeToggle />
      <a class="nav-contact" href="/consulting" data-motion-interactive>Work together <span aria-hidden="true" data-motion-arrow>→</span></a>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    /* Keeps the header still while page content cross-fades. */
    view-transition-name: site-header;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .signal-bar {
    color: var(--inverse-ink);
    background: var(--signal-deep);
    font-size: var(--text-label);
    letter-spacing: 0.04em;
  }

  .signal-bar__inner,
  .nav-shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-actions {
    display: flex;
    gap: 0.65rem;
    align-items: center;
  }

  .signal-bar__inner {
    min-height: 1.9rem;
    gap: 1rem;
  }

  .signal-bar p {
    margin: 0;
  }

  .signal-bar p span {
    margin-right: 0.45rem;
    color: var(--signal-bright);
    font-size: 0.52rem;
  }

  .signal-bar a {
    color: inherit;
    text-decoration-color: var(--signal);
    text-underline-offset: 0.2em;
  }

  .nav-shell {
    min-height: 4.25rem;
    gap: 1.15rem;
  }

  .wordmark {
    display: grid;
    width: 2.3rem;
    height: 2.3rem;
    place-items: center;
    flex: 0 0 auto;
    color: var(--inverse-ink);
    background: var(--signal-deep);
    font-weight: 800;
    font-size: var(--text-label);
    letter-spacing: -0.08em;
    text-decoration: none;
    transform: rotate(-3deg);
  }

  nav ul {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav li {
    display: flex;
    align-items: center;
  }

  nav li + li::before {
    margin: 0 0.72rem;
    color: var(--line-strong);
    content: "|";
  }

  nav a,
  .nav-contact {
    color: var(--ink-soft);
    font-size: var(--text-label);
    font-weight: 650;
    text-decoration: none;
  }

  nav a:is(:hover, :focus-visible),
  .nav-contact:is(:hover, :focus-visible) {
    color: var(--signal);
  }

  nav a[aria-current] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }

  .nav-contact {
    padding: 0.58rem 0.72rem;
    color: var(--inverse-ink);
    background: var(--signal-fill);
  }

  .nav-contact:is(:hover, :focus-visible) {
    color: var(--inverse-ink);
    background: var(--signal-fill-hover);
  }

  @media (max-width: 760px) {
    /* The consulting link is repeated by "Work together", so the bar goes. */
    .signal-bar {
      display: none;
    }

    .nav-shell {
      min-height: auto;
      flex-wrap: wrap;
      padding-block: 0.75rem;
    }

    .nav-shell nav {
      order: 3;
      width: 100%;
      overflow-x: auto;
      padding-top: 0.7rem;
      border-top: 1px dotted var(--line-strong);
      scrollbar-width: none;
    }

    .nav-shell nav::-webkit-scrollbar {
      display: none;
    }

    nav ul {
      width: max-content;
      gap: 0.75rem;
    }

    nav li + li::before {
      content: none;
    }

    nav a {
      display: inline-flex;
      min-height: 2rem;
      align-items: center;
    }

    .nav-contact {
      padding: 0.55rem 0.65rem;
    }
  }

  /* Below 360px the links scroll; fade the edge so that reads as scrollable. */
  @media (max-width: 359px) {
    .nav-shell nav {
      mask-image: linear-gradient(to right, #000 calc(100% - 1.5rem), transparent);
    }
  }
</style>
