---
import ThemeToggle from "./ThemeToggle.astro";

const navigation = [
  { name: "Projects", href: "/projects", section: ["/projects"] },
  { name: "Articles", href: "/articles", section: ["/articles", "/newsletters"] },
  { name: "Speaking", href: "/speaking", section: ["/speaking"] },
  { name: "Consulting", href: "/consulting", section: ["/consulting"] },
  { name: "About", href: "/about", section: ["/about"] },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentState = (item: (typeof navigation)[number]) => {
  if (currentPath === item.href) return "page";
  return item.section.some((path) => currentPath.startsWith(`${path}/`))
    ? "true"
    : undefined;
};
---

<header class="site-header">
  <div class="site-container nav-shell">
    <a class="wordmark" href="/">
      <img
        class="wordmark__wave"
        src="/images/wave.png"
        alt=""
        width="22"
        height="22"
        decoding="async"
      />
      <span>Dan Ferg</span>
    </a>

    <nav aria-label="Main navigation">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={currentState(item)}
                data-astro-prefetch="hover"
              >
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav-actions">
      <ThemeToggle />
      <a class="nav-contact" href="/consulting" data-motion-interactive>
        Get in touch
        <span aria-hidden="true" data-motion-arrow>→</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(10px);
    /* Keeps the header still while page content cross-fades. */
    view-transition-name: site-header;
  }

  .nav-shell {
    display: flex;
    min-height: 3.5rem;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
  }

  .wordmark {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    flex: 0 0 auto;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .wordmark__wave {
    display: block;
    width: 1.35rem;
    height: 1.35rem;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .nav-shell nav {
    display: flex;
    align-self: stretch;
  }

  nav ul {
    display: flex;
    gap: 1.75rem;
    align-items: stretch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav li {
    display: flex;
    align-items: center;
  }

  nav a {
    position: relative;
    display: flex;
    align-self: stretch;
    align-items: center;
    color: var(--ink-soft);
    font-size: 0.875rem;
    font-weight: 450;
    text-decoration: none;
  }

  nav a:is(:hover, :focus-visible) {
    color: var(--ink);
  }

  nav a[aria-current] {
    color: var(--ink);
    font-weight: 500;
  }

  nav a[aria-current]::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--signal);
    content: "";
  }

  .nav-actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .nav-contact {
    display: inline-flex;
    height: 2.3rem;
    gap: 0.45rem;
    align-items: center;
    padding: 0 0.95rem;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    color: var(--inverse-ink);
    background: var(--signal-fill);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 140ms ease;
  }

  .nav-contact:is(:hover, :focus-visible) {
    background: var(--signal-fill-hover);
  }

  @media (max-width: 820px) {
    .nav-shell {
      min-height: auto;
      flex-wrap: wrap;
      gap: 0;
      padding-block: 0.65rem 0;
    }

    .nav-shell nav {
      order: 3;
      width: 100%;
      overflow-x: auto;
      margin-top: 0.65rem;
      border-top: 1px solid var(--line);
      scrollbar-width: none;
      margin-bottom: -1px;
    }

    .nav-shell nav::-webkit-scrollbar {
      display: none;
    }

    nav ul {
      width: max-content;
      gap: 1.25rem;
    }

    nav a {
      min-height: 2.6rem;
    }

    nav a[aria-current]::after {
      bottom: 0;
    }

    .nav-contact {
      height: 2.2rem;
      padding: 0 0.75rem;
      font-size: 0.82rem;
    }
  }

  @media (max-width: 359px) {
    .nav-shell nav {
      mask-image: linear-gradient(to right, #000 calc(100% - 1.5rem), transparent);
    }
  }
</style>
