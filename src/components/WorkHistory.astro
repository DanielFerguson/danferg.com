---
interface Role {
  title: string;
  organisation: string;
  period: string;
  datetime: string;
  description: string;
  icon: string;
  fullBleed?: boolean;
  invertDark?: boolean;
}

const roles: Role[] = [
  {
    title: "Head of Innovation",
    organisation: "Spatial Media",
    period: "Oct 2026 – Present",
    datetime: "2026-10",
    description:
      "Running AI, product, and growth experiments at an interactive 3D visualisation and digital engagement company, from rail driver training to community portals.",
    icon: "/images/workplaces/spatial-media.png",
    invertDark: true,
  },
  {
    title: "Chief Executive Officer",
    organisation: "Communiti Labs",
    period: "Aug 2023 – Jul 2026",
    datetime: "2023-08",
    description:
      "Co-founded and led a civic-tech startup helping councils and practitioners turn community feedback into clear, usable evidence.",
    icon: "/images/workplaces/communiti-labs.png",
  },
  {
    title: "President",
    organisation: "Helping Group",
    period: "Feb 2020 – Present",
    datetime: "2020-02",
    description:
      "Founded a charity after the 2020 bushfires to build practical digital services connecting people with support before, during, and after disasters.",
    icon: "/images/workplaces/helping-group.png",
  },
  {
    title: "Owner",
    organisation: "Ferguson Livestock",
    period: "Oct 2022 – Present",
    datetime: "2022-10",
    description:
      "Family-run Murray Grey stud and farm-direct beef business in Snake Valley, Victoria. Built the online store whose first beef drop sold out in four minutes.",
    icon: "/images/workplaces/ferguson-livestock.png",
    fullBleed: true,
  },
  {
    title: "Consultant",
    organisation: "Chepstowe Consulting",
    period: "Aug 2022 – Sep 2023",
    datetime: "2022-08",
    description:
      "Designed custom software for insurance and wealth-management teams, including a CRM supporting more than $10M in new business.",
    icon: "/images/workplaces/chepstowe-consulting.svg",
    fullBleed: true,
  },
  {
    title: "Digital Performance Manager",
    organisation: "Aon",
    period: "Jan 2023 – Jul 2023",
    datetime: "2023-01",
    description:
      "Moved from digital analysis into performance management, using data and cleaner systems to improve operations and decision-making.",
    icon: "/images/workplaces/aon.png",
    fullBleed: true,
  },
  {
    title: "Chief Technology Officer",
    organisation: "Imperial Wealth",
    period: "Mar 2021 – Aug 2022",
    datetime: "2021-03",
    description:
      "Led the design and engineering team, brought five business units into one client entry point, and built operational software for international sites.",
    icon: "/images/workplaces/imperial-wealth.svg",
    invertDark: true,
  },
  {
    title: "Full Stack Developer",
    organisation: "CeRDI",
    period: "Feb 2019 – Jan 2021",
    datetime: "2019-02",
    description:
      "Built data pipelines, spatial tools, and knowledge portals for environmental monitoring, regional collaboration, and family-violence response.",
    icon: "/images/workplaces/cerdi.png",
  },
];
---

<ol class="work-history" aria-label="Career history" data-motion-group>
  {
    roles.map((role) => (
      <li class="work-role" data-motion-item>
        <div class="work-role__meta">
          <time datetime={role.datetime}>{role.period}</time>
          <span class="work-role__org">
            <span
              class:list={[
                "work-role__icon",
                { "work-role__icon--bleed": role.fullBleed },
              ]}
              aria-hidden="true"
            >
              <img
                src={role.icon}
                alt=""
                width="20"
                height="20"
                loading="lazy"
                decoding="async"
                class:list={[{ "work-role__img--invert-dark": role.invertDark }]}
              />
            </span>
            <span>{role.organisation}</span>
          </span>
        </div>

        <div class="work-role__body">
          <h3>{role.title}</h3>
          <p class="work-role__description">{role.description}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .work-history {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .work-role {
    display: grid;
    grid-template-columns: minmax(12rem, 0.36fr) minmax(0, 1fr);
    gap: 1rem clamp(1.5rem, 4vw, 3.5rem);
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .work-role__meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  time {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .work-role__org {
    display: inline-flex;
    gap: 0.55rem;
    align-items: center;
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .work-role__icon {
    display: inline-grid;
    width: 1.375rem;
    height: 1.375rem;
    place-items: center;
    flex: 0 0 auto;
    overflow: hidden;
    padding: 2px;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--paper);
  }

  .work-role__icon--bleed {
    padding: 0;
  }

  .work-role__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .work-role__icon--bleed img {
    object-fit: cover;
  }

  :global(:root[data-theme="dark"]) .work-role__img--invert-dark {
    filter: invert(1) brightness(1.08);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .work-role__img--invert-dark {
      filter: invert(1) brightness(1.08);
    }
  }

  .work-role__body {
    min-width: 0;
  }

  h3 {
    margin: 0;
    color: var(--ink);
    font-size: 1.075rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .work-role__description {
    max-width: 62ch;
    margin: 0.45rem 0 0;
    color: var(--ink-soft);
    font-size: 0.925rem;
    line-height: 1.6;
  }

  @media (max-width: 700px) {
    .work-role {
      grid-template-columns: 1fr;
      gap: 0.45rem;
      padding-block: 1.25rem;
    }

    .work-role__meta {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.35rem 0.75rem;
      align-items: center;
    }
  }
</style>
