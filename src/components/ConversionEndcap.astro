---
export interface EndcapAction {
  label: string;
  href: string;
  meta: string;
  description?: string;
  external?: boolean;
  download?: string | boolean;
}

interface Props {
  headingId: string;
  eyebrow: string;
  title: string;
  description: string;
  actions: EndcapAction[];
}

const { headingId, eyebrow, title, description, actions } = Astro.props;
---

<section class="endcap-band band" aria-labelledby={headingId} data-motion-reveal>
  <div class="band__frame endcap-band__frame">
    <aside class="conversion-endcap">
      <div class="conversion-endcap__copy">
        <p class="conversion-endcap__eyebrow">{eyebrow}</p>
        <h2 id={headingId}>{title}</h2>
        <p class="conversion-endcap__desc">{description}</p>
      </div>

      <nav class="conversion-endcap__actions" aria-label="Next steps">
        {
          actions.map((action, index) => {
            const opensAway =
              action.external || action.href.startsWith("mailto:");
            const isPage = !opensAway && !/\.[a-z0-9]+$/i.test(action.href);

            return (
              <a
                class:list={[
                  "conversion-endcap__action",
                  { "conversion-endcap__action--primary": index === 0 },
                ]}
                href={action.href}
                download={action.download}
                target={action.external ? "_blank" : undefined}
                rel={action.external ? "noopener noreferrer" : undefined}
                data-astro-prefetch={isPage ? "hover" : undefined}
                data-motion-interactive
              >
                <span class="conversion-endcap__action-copy">
                  <small>{action.meta}</small>
                  <strong>{action.label}</strong>
                  {action.description && <span>{action.description}</span>}
                </span>
                <span
                  class="conversion-endcap__arrow"
                  aria-hidden="true"
                  data-motion-arrow
                >
                  {opensAway ? "↗" : "→"}
                </span>
              </a>
            );
          })
        }
      </nav>
    </aside>
  </div>
</section>

<style>
  .endcap-band__frame {
    padding-block: clamp(2.75rem, 5vw, 4.25rem);
  }

  .conversion-endcap {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(19rem, 0.9fr);
    gap: clamp(1.75rem, 4vw, 3.25rem);
    align-items: center;
    padding: clamp(1.85rem, 4.5vw, 3.25rem);
    border: 1px solid rgb(204 102 255 / 26%);
    border-radius: var(--radius-md);
    color: var(--inverse-ink);
    background:
      radial-gradient(
        circle at 92% 14%,
        rgb(204 102 255 / 32%) 0%,
        transparent 46%
      ),
      radial-gradient(
        circle at 10% 95%,
        rgb(79 57 246 / 50%) 0%,
        transparent 52%
      ),
      var(--signal-indigo);
  }

  .conversion-endcap__eyebrow {
    margin: 0 0 0.65rem;
    color: var(--signal-bright);
    font-size: 0.875rem;
    font-weight: 500;
  }

  h2 {
    max-width: 18ch;
    margin: 0;
    color: var(--inverse-ink);
    font-size: clamp(1.75rem, 3.4vw, 2.65rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .conversion-endcap__desc {
    max-width: 36rem;
    margin: 0.9rem 0 0;
    color: rgb(250 249 255 / 84%);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .conversion-endcap__actions {
    display: grid;
    gap: 0.75rem;
  }

  .conversion-endcap__action {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding: 1rem 1.15rem;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: var(--radius-md);
    color: var(--inverse-ink);
    background: rgb(255 255 255 / 7%);
    text-decoration: none;
    transition:
      background-color 140ms ease,
      border-color 140ms ease;
  }

  .conversion-endcap__action:is(:hover, :focus-visible) {
    border-color: rgb(255 255 255 / 38%);
    background: rgb(255 255 255 / 14%);
  }

  .conversion-endcap__action--primary {
    border-color: transparent;
    color: var(--signal-indigo);
    background: #ffffff;
  }

  .conversion-endcap__action--primary:is(:hover, :focus-visible) {
    border-color: transparent;
    background: #f2eeff;
  }

  .conversion-endcap__action-copy {
    display: grid;
    gap: 0.2rem;
  }

  .conversion-endcap__action small {
    color: var(--signal-bright);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .conversion-endcap__action--primary small {
    color: var(--signal);
  }

  .conversion-endcap__action strong {
    font-size: 0.95rem;
    font-weight: 550;
    line-height: 1.3;
  }

  .conversion-endcap__action-copy > span {
    color: rgb(250 249 255 / 78%);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .conversion-endcap__action--primary .conversion-endcap__action-copy > span {
    color: var(--ink-soft);
  }

  .conversion-endcap__arrow {
    font-size: 1rem;
  }

  @media (max-width: 840px) {
    .conversion-endcap {
      grid-template-columns: 1fr;
    }
  }
</style>
