---
import { getCollection } from "astro:content";
import { editorialUpdates } from "../data/editorial-updates";
import { tags as tagCatalogue, type TagId } from "../data/taxonomy";

interface Props {
  currentPath: string;
  kind: "articles" | "newsletters";
  tags?: TagId[];
}

interface RelatedItem {
  title: string;
  description: string;
  href: string;
  date: string;
  meta: string;
  tags: string[];
}

const { currentPath, kind, tags = [] } = Astro.props;
const entries = kind === "articles"
  ? await getCollection("articles")
  : await getCollection("newsletters");
const sameKind: RelatedItem[] = entries
  .filter((entry) => entry.data.canonicalUrl !== currentPath)
  .map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    href: entry.data.canonicalUrl,
    date: entry.data.date,
    meta: kind === "articles" ? "Article" : "Newsletter",
    tags: (entry.data.tags ?? []) as string[],
  }));
const updates: RelatedItem[] = kind === "articles"
  ? editorialUpdates
      .filter((entry) => entry.canonicalUrl !== currentPath)
      .map((entry) => ({
        title: entry.title,
        description: entry.description,
        href: entry.canonicalUrl,
        date: entry.date,
        meta: "Research",
        tags: [],
      }))
  : [];

// Most shared tags first, newest first among equals.
const sharedTags = (item: RelatedItem) =>
  item.tags.filter((tag) => (tags as string[]).includes(tag)).length;
const ranked = [...sameKind, ...updates].sort(
  (a, b) =>
    sharedTags(b) - sharedTags(a) ||
    new Date(b.date).getTime() - new Date(a.date).getTime(),
);

// One case study that illustrates the piece's first tag that has any.
const projects = kind === "articles" ? await getCollection("projects") : [];
const projectPath = tags
  .flatMap((tag) => tagCatalogue[tag]?.projects ?? [])
  .find((path) => path !== currentPath);
const project = projects.find((entry) => entry.data.canonicalUrl === projectPath);
const projectItem = project
  ? {
      title: project.data.title,
      description: project.data.description,
      href: project.data.canonicalUrl,
      meta: "Case study",
    }
  : null;

const related = projectItem
  ? [...ranked.slice(0, 1), projectItem]
  : ranked.slice(0, 2);
const archive = {
  title: kind === "articles" ? "Browse all articles" : "Browse all newsletters",
  description:
    kind === "articles"
      ? "The full archive of essays, product research, and notes from building."
      : "The 2022 archive of longer project notes and experiments built in public.",
  href: kind === "articles" ? "/articles" : "/newsletters",
  meta: "Archive",
};
---

<section class="band band--subtle" aria-labelledby="related-title" data-motion-reveal>
  <div class="band__frame related">
    <div class="related__header">
      <p class="page-hero__eyebrow">Keep reading</p>
      <h2 id="related-title">Related reading.</h2>
    </div>
    <nav class="related__grid" aria-label="Related content" data-motion-group>
      {related.map((item) => (
        <a href={item.href} data-motion-item data-motion-interactive data-astro-prefetch="hover">
          <small>{item.meta}</small>
          <strong>{item.title}</strong>
          <span>{item.description}</span>
          <i aria-hidden="true" data-motion-arrow>→</i>
        </a>
      ))}
      <a href={archive.href} data-motion-item data-motion-interactive data-astro-prefetch="hover">
        <small>{archive.meta}</small>
        <strong>{archive.title}</strong>
        <span>{archive.description}</span>
        <i aria-hidden="true" data-motion-arrow>→</i>
      </a>
    </nav>
  </div>
</section>

<style>
  .related {
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .related__header {
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.15rem);
    font-weight: 550;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper);
  }

  a {
    display: flex;
    flex-direction: column;
    min-height: 13.5rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border-right: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: background-color 140ms ease;
  }

  a:last-child {
    border-right: 0;
  }

  a:is(:hover, :focus-visible) {
    background: var(--paper-subtle);
  }

  a:is(:hover, :focus-visible) strong {
    color: var(--signal);
  }

  small {
    color: var(--ink-muted);
    font-size: 0.78rem;
    font-weight: 500;
  }

  strong {
    margin-top: 1.15rem;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    transition: color 140ms ease;
  }

  a > span {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  i {
    margin-top: auto;
    padding-top: 1.25rem;
    align-self: flex-end;
    color: var(--ink-muted);
    font-style: normal;
  }

  a:is(:hover, :focus-visible) i {
    color: var(--signal);
  }

  @media (max-width: 760px) {
    .related__grid {
      grid-template-columns: 1fr;
    }

    a {
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    a:last-child {
      border-bottom: 0;
    }
  }
</style>
