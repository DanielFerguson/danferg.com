---
interface Props {
  summary: string;
}

const { summary } = Astro.props;
---

<aside class="article-summary" aria-labelledby="article-summary-label">
  <p class="article-summary__label" id="article-summary-label">In short</p>
  <p class="article-summary__body">{summary}</p>
</aside>

<style>
  .article-summary {
    margin: 0 0 2rem;
    padding: 1.15rem 1.35rem;
    border: 1px solid var(--line);
    border-left: 3px solid var(--signal);
    border-radius: var(--radius-md);
    background: var(--paper-subtle);
  }

  .article-summary__label {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    margin: 0 0 0.45rem;
    color: var(--signal);
    font-size: 0.84rem;
    font-weight: 500;
  }

  .article-summary__body {
    margin: 0;
    color: var(--ink);
    font-size: 0.98rem;
    line-height: 1.65;
  }
</style>
