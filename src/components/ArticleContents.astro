---
interface Props {
  sections: Array<[string, string]>;
}

const { sections } = Astro.props;
---

<nav
  class="article-contents"
  id="contents"
  tabindex="-1"
  aria-labelledby="contents-label"
>
  <p id="contents-label">In this article</p>
  <ol role="list">
    {
      sections.map(([id, label], index) => (
        <li>
          <a href={`#${id}`}>
            <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            {label}
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .article-contents {
    margin: 0 0 2.25rem;
    padding: 1.15rem 1.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper-subtle);
  }

  .article-contents p {
    margin: 0 0 0.85rem;
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 550;
  }

  .article-contents ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-contents li,
  .article-contents li + li {
    margin: 0;
    padding: 0;
  }

  .article-contents a {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.32rem 0;
    color: var(--ink-soft);
    font-size: 0.88rem;
    line-height: 1.45;
    text-decoration: none;
  }

  .article-contents a:is(:hover, :focus-visible) {
    color: var(--signal);
  }

  .article-contents a span {
    flex-shrink: 0;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-variant-numeric: tabular-nums;
  }

  :global(.article-prose [id]) {
    scroll-margin-top: 5.5rem;
  }

  @media (max-width: 560px) {
    .article-contents ol {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    .article-contents {
      break-inside: avoid;
    }
  }
</style>
