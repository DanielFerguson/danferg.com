---
/** Tag chips for an article header. Each links to the static tag page. */
import { tags as tagCatalogue, tagHref, type TagId } from "../data/taxonomy";

interface Props {
  tags?: readonly string[];
  size?: "sm" | "md";
  /** Emit Pagefind filter metadata (only wanted once per page, in the article header). */
  pagefind?: boolean;
}

const { tags = [], size = "md", pagefind = false } = Astro.props;
const items = tags.filter((id): id is TagId => id in tagCatalogue);
---

{
  items.length > 0 && (
    <ul
      class:list={["article-tags", `article-tags--${size}`]}
      aria-label="Topics"
    >
      {items.map((id) => (
        <li>
          <a
            href={tagHref(id)}
            data-pagefind-filter={pagefind ? "tag" : undefined}
          >
            {tagCatalogue[id].label}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-tags li,
  .article-tags li + li {
    margin: 0;
    padding: 0;
  }

  .article-tags a {
    display: inline-block;
    padding: 0.22rem 0.72rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink-soft);
    background: var(--paper);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.5;
    text-decoration: none;
    transition:
      border-color 140ms ease,
      color 140ms ease,
      background-color 140ms ease;
  }

  .article-tags--sm a {
    padding: 0.14rem 0.58rem;
    font-size: 0.78rem;
  }

  .article-tags a:is(:hover, :focus-visible) {
    border-color: var(--signal);
    color: var(--signal);
    background: var(--signal-soft);
  }
</style>
