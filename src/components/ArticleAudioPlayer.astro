---
interface AudioMetadata {
  url: string;
  mimeType: "audio/mpeg";
  byteLength: number;
}

interface Props {
  audio: AudioMetadata;
  title: string;
}

const { audio, title } = Astro.props;
const headingId = `listen-${title
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-|-$/g, "")}`;
---

<section
  class="article-audio"
  aria-labelledby={headingId}
  data-article-audio
  data-audio-title={title}
>
  <div class="article-audio__header">
    <div>
      <h2 id={headingId} class="article-audio__title">Listen to this article</h2>
      <p class="article-audio__note">AI narration produced with ElevenLabs.</p>
    </div>
    <a class="article-audio__download" href={audio.url} download>
      Download MP3 <span aria-hidden="true">↓</span>
    </a>
  </div>
  <div class="article-audio__player">
    <audio
      controls
      preload="metadata"
      aria-label={`Audio narration of ${title}`}
      data-audio-control
      data-audio-byte-length={audio.byteLength}
    >
      <source src={audio.url} type={audio.mimeType} />
      Your browser does not support embedded audio. <a href={audio.url}>Download the MP3</a> instead.
    </audio>
  </div>
</section>

<style>
  .article-audio {
    display: grid;
    gap: 0.9rem;
    margin: 0 0 2.25rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper-subtle);
  }

  .article-audio__header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-items: baseline;
    justify-content: space-between;
  }

  .article-audio__title {
    margin: 0;
    color: var(--ink);
    font-size: 0.96rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .article-audio__note {
    margin: 0.2rem 0 0;
    color: var(--ink-muted);
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .article-audio__player {
    min-width: 0;
  }

  audio {
    display: block;
    width: 100%;
    height: 2.75rem;
    accent-color: var(--signal);
  }

  .article-audio__download {
    color: var(--ink-soft);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .article-audio__download:hover {
    color: var(--signal);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>

<script>
  const players = document.querySelectorAll<HTMLElement>("[data-article-audio]");

  for (const player of players) {
    const audio = player.querySelector<HTMLAudioElement>("[data-audio-control]");
    const title = player.dataset.audioTitle;

    if (!audio || !title || !("mediaSession" in navigator)) continue;

    audio.addEventListener(
      "play",
      () => {
        navigator.mediaSession.metadata = new MediaMetadata({
          title,
          artist: "Dan Ferguson",
          album: "Dan Ferg — Articles",
        });
      },
      { once: true },
    );
  }
</script>
