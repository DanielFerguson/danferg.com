---
interface ImpactStat {
  displayValue: string;
  accessibleValue: string;
  target: number;
  decimals?: number;
  prefix?: string;
  suffix?: string;
  label: string;
  href: string;
  sourceLabel: string;
}

const impactStats: ImpactStat[] = [
  {
    displayValue: "2.5M+",
    accessibleValue: "More than 2.5 million",
    target: 2.5,
    decimals: 1,
    suffix: "M+",
    label: "Community submissions analysed at Communiti Labs",
    href: "/projects/communitilabs",
    sourceLabel: "Read the Communiti Labs retrospective",
  },
  {
    displayValue: "$10M+",
    accessibleValue: "More than 10 million dollars",
    target: 10,
    prefix: "$",
    suffix: "M+",
    label: "New business run through a custom CRM",
    href: "/#work",
    sourceLabel: "See consulting experience",
  },
  {
    displayValue: "1,500+",
    accessibleValue: "More than 1,500",
    target: 1500,
    suffix: "+",
    label: "Cattle records searchable on Murray Grey Aus",
    href: "/projects/murray-grey-association-australia",
    sourceLabel: "Read the Murray Grey Aus case study",
  },
  {
    displayValue: "4 min",
    accessibleValue: "Four minutes",
    target: 4,
    suffix: " min",
    label: "First farm-direct beef drop to sell out",
    href: "/projects/ferguson-livestock",
    sourceLabel: "Read the Ferguson Livestock case study",
  },
];
---

<section
  id="proof"
  class="impact-band band"
  aria-label="Selected outcomes"
  data-impact-stats
  data-motion-impact
>
  <div class="impact-band__frame">
    <ol class="impact-stats__grid" aria-label="Selected outcomes">
      {
        impactStats.map((stat) => (
          <li data-impact-card>
            <a
              href={stat.href}
              aria-label={`${stat.accessibleValue} ${stat.label}. ${stat.sourceLabel}.`}
              data-motion-interactive
            >
              <strong aria-hidden="true">
                <span
                  data-impact-value
                  data-target={stat.target}
                  data-decimals={stat.decimals || 0}
                  data-prefix={stat.prefix || ""}
                  data-suffix={stat.suffix || ""}
                >
                  {stat.displayValue}
                </span>
              </strong>
              <span class="impact-stat__label">{stat.label}</span>
              <span class="impact-stat__arrow" aria-hidden="true" data-motion-arrow>
                →
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .impact-band__frame {
    position: relative;
    width: min(calc(100% - 2.5rem), var(--content-width));
    margin-inline: auto;
    border-inline: 1px solid var(--line);
  }

  .impact-band__frame::before,
  .impact-band__frame::after {
    position: absolute;
    bottom: -4px;
    width: 7px;
    height: 7px;
    pointer-events: none;
    content: "";
    background:
      linear-gradient(var(--line-strong), var(--line-strong)) center / 1px 100% no-repeat,
      linear-gradient(var(--line-strong), var(--line-strong)) center / 100% 1px no-repeat;
  }

  .impact-band__frame::before {
    left: -4px;
  }

  .impact-band__frame::after {
    right: -4px;
  }

  .impact-stats__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .impact-stats__grid li {
    min-width: 0;
    border-right: 1px solid var(--line);
  }

  .impact-stats__grid li:last-child {
    border-right: 0;
  }

  .impact-stats__grid a {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 0.55rem;
    padding: clamp(1.35rem, 2.8vw, 2rem);
    color: var(--ink);
    text-decoration: none;
    transition: background-color 140ms ease;
  }

  .impact-stats__grid a:is(:hover, :focus-visible) {
    background: var(--paper-subtle);
  }

  .impact-stats__grid a:is(:hover, :focus-visible) strong,
  .impact-stats__grid a:is(:hover, :focus-visible) .impact-stat__arrow {
    color: var(--signal);
  }

  strong {
    display: block;
    color: var(--ink);
    font-size: clamp(1.9rem, 3.2vw, 2.65rem);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1.05;
    letter-spacing: -0.04em;
    white-space: nowrap;
    transition: color 140ms ease;
  }

  .impact-stat__label {
    max-width: 24ch;
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .impact-stat__arrow {
    margin-top: auto;
    padding-top: 0.45rem;
    color: var(--ink-muted);
    font-size: 0.9rem;
    transition: color 140ms ease;
  }

  @media (max-width: 960px) {
    .impact-stats__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .impact-stats__grid li:nth-child(2) {
      border-right: 0;
    }

    .impact-stats__grid li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 640px) {
    .impact-band__frame {
      width: min(calc(100% - 1.5rem), var(--content-width));
    }

    .impact-stats__grid a {
      padding: 1.15rem 1rem;
    }
  }
</style>
