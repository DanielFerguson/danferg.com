---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  caption: string;
  label?: string;
  surface?: "dark" | "light" | "auto";
}

export interface Props {
  number: string | number;
  label: string;
  layout?: "single" | "two-up" | "theme-pair" | "stack";
  items?: GalleryImage[];
  light?: ImageMetadata;
  dark?: ImageMetadata;
  alt?: string;
  caption?: string;
}

const {
  number,
  label,
  layout = "single",
  items = [],
  light,
  dark,
  alt = "",
  caption = "",
} = Astro.props;

const figureNumber = String(number).padStart(2, "0");
const sizes =
  layout === "two-up"
    ? "(min-width: 1280px) 512px, (min-width: 761px) calc((100vw - 44px) / 2), calc(100vw - 26px)"
    : "(min-width: 1280px) 1024px, calc(100vw - 42px)";
---

<figure
  class="cadence-gallery"
  data-layout={layout}
  aria-label={`${label}, figure ${figureNumber}`}
>
  <figcaption class="cadence-gallery__bar">
    <span>{label}</span>
    {layout === "theme-pair" && (
      <span class="cadence-gallery__hint">Follows site light &amp; dark theme</span>
    )}
  </figcaption>

  {
    layout === "theme-pair" && light && dark ? (
      <div class="cadence-gallery__panel">
        <div class="cadence-gallery__theme-media">
          <div class="cadence-gallery__variant cadence-gallery__variant--light">
            <Picture
              src={light}
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              widths={[640, 960, 1280, 1920]}
              sizes={sizes}
              alt={alt}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="cadence-gallery__variant cadence-gallery__variant--dark">
            <Picture
              src={dark}
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              widths={[640, 960, 1280, 1920]}
              sizes={sizes}
              alt={alt}
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
        {caption && <p class="cadence-gallery__caption">{caption}</p>}
      </div>
    ) : (
      <div class="cadence-gallery__grid">
        {items.map((item) => (
          <div class="cadence-gallery__panel">
            <div
              class:list={[
                "cadence-gallery__media",
                item.surface && `cadence-gallery__media--${item.surface}`,
              ]}
            >
              <Picture
                src={item.src}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                alt={item.alt}
                widths={[480, 720, 960, 1440]}
                sizes={sizes}
                loading="lazy"
                decoding="async"
              />
            </div>
            <p class="cadence-gallery__caption">
              {item.label && <strong>{item.label}</strong>}
              <span>{item.caption}</span>
            </p>
          </div>
        ))}
      </div>
    )
  }
</figure>

<style>
  .cadence-gallery {
    --cadence-breakout-width: min(calc(100vw - 2.5rem), 64rem);
    position: relative;
    left: 50%;
    width: var(--cadence-breakout-width);
    max-width: none;
    margin: clamp(2.25rem, 5vw, 3.5rem) 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper-subtle);
    transform: translateX(-50%);
  }

  .cadence-gallery__bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    align-items: baseline;
    justify-content: space-between;
    margin: 0;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .cadence-gallery__hint {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--ink-muted);
  }

  .cadence-gallery__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--line);
  }

  .cadence-gallery[data-layout="two-up"] .cadence-gallery__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .cadence-gallery__panel {
    display: flex;
    min-width: 0;
    flex-direction: column;
    background: var(--paper);
  }

  .cadence-gallery__media {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--paper-subtle);
  }

  .cadence-gallery__media--dark {
    background: #0d1421;
  }

  .cadence-gallery__media--light {
    align-items: flex-start;
    padding: clamp(0.85rem, 2vw, 1.35rem);
    background: var(--paper-subtle);
  }

  .cadence-gallery__media :global(picture),
  .cadence-gallery__media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 0;
    border-radius: 0;
  }

  .cadence-gallery__media--light :global(img) {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }

  .cadence-gallery__theme-media {
    background: var(--paper-subtle);
  }

  .cadence-gallery__variant :global(picture),
  .cadence-gallery__variant :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 0;
    border-radius: 0;
  }

  .cadence-gallery__variant--dark {
    display: none;
  }

  :global(:root[data-theme="dark"]) .cadence-gallery__variant--light {
    display: none;
  }

  :global(:root[data-theme="dark"]) .cadence-gallery__variant--dark {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .cadence-gallery__variant--light {
      display: none;
    }

    :global(:root:not([data-theme])) .cadence-gallery__variant--dark {
      display: block;
    }
  }

  .cadence-gallery__caption {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0.9rem 1.15rem;
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .cadence-gallery__caption strong {
    color: var(--ink);
    font-size: 0.86rem;
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .cadence-gallery {
      --cadence-breakout-width: calc(100vw - 1.5rem);
    }

    .cadence-gallery[data-layout="two-up"] .cadence-gallery__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
