---
import {
  cadenceIOSStudioGroups,
  cadenceIOSSyncChannels,
} from "../../data/cadence-ios";
---

<section
  id="ios-architecture"
  class="cadence-ios-panel"
  aria-labelledby="cadence-ios-panel-heading"
>
  <header class="cadence-ios-panel__bar">
    <h3 id="cadence-ios-panel-heading">Camera studio &amp; sync breakdown</h3>
    <span>iOS 26.0+ · iPhone · shared Swift 6 core with macOS Cadence</span>
  </header>

  <div class="cadence-ios-panel__grid">
    {cadenceIOSStudioGroups.map((group) => (
      <div class="cadence-ios-panel__cell">
        <span class="cadence-ios-panel__label">{group.label}</span>
        <h4>{group.title}</h4>
        <ul>
          {group.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="cadence-ios-panel__sync">
    <div class="cadence-ios-panel__sync-head">
      <h4>Two-way script sync with Cadence for Mac</h4>
      <span>Device-local prompter settings stay independent</span>
    </div>

    <div class="cadence-ios-panel__channels">
      {cadenceIOSSyncChannels.map((channel) => (
        <div class="cadence-ios-panel__channel">
          <div class="cadence-ios-panel__channel-head">
            <strong>{channel.name}</strong>
            <span class="cadence-ios-panel__badge">{channel.availability}</span>
          </div>
          <code class="cadence-ios-panel__transport">{channel.transport}</code>
          <p>{channel.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cadence-ios-panel {
    --cadence-breakout-width: min(calc(100vw - 2.5rem), 64rem);
    position: relative;
    left: 50%;
    width: var(--cadence-breakout-width);
    max-width: none;
    margin: clamp(2.25rem, 5vw, 3.5rem) 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper-subtle);
    transform: translateX(-50%);
    scroll-margin-top: 5.5rem;
  }

  .cadence-ios-panel__bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: 0.82rem;
  }

  .cadence-ios-panel__bar h3 {
    margin: 0;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .cadence-ios-panel__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    border-bottom: 1px solid var(--line);
    background: var(--line);
  }

  .cadence-ios-panel__cell {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.15rem 1.25rem;
    background: var(--paper);
  }

  .cadence-ios-panel__label {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .cadence-ios-panel__cell h4 {
    margin: 0;
    color: var(--ink);
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .cadence-ios-panel__cell ul {
    margin: 0.3rem 0 0;
    padding-left: 1.05rem;
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.58;
  }

  .cadence-ios-panel__cell li + li {
    margin-top: 0.38rem;
  }

  .cadence-ios-panel__sync {
    background: var(--paper-subtle);
  }

  .cadence-ios-panel__sync-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: 0.8rem;
  }

  .cadence-ios-panel__sync-head h4 {
    margin: 0;
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .cadence-ios-panel__channels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
  }

  .cadence-ios-panel__channel {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.05rem 1.25rem;
    background: color-mix(in srgb, var(--signal-soft) 28%, var(--paper));
  }

  .cadence-ios-panel__channel-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.65rem;
    align-items: baseline;
    justify-content: space-between;
  }

  .cadence-ios-panel__channel-head strong {
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .cadence-ios-panel__badge {
    color: var(--ink-muted);
    font-size: 0.74rem;
    font-weight: 500;
  }

  .cadence-ios-panel__transport {
    align-self: flex-start;
    padding: 0.18rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    overflow-wrap: anywhere;
  }

  .cadence-ios-panel__channel p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  @media (max-width: 780px) {
    .cadence-ios-panel {
      --cadence-breakout-width: calc(100vw - 1.5rem);
    }

    .cadence-ios-panel__grid,
    .cadence-ios-panel__channels {
      grid-template-columns: 1fr;
    }
  }
</style>
