---
import { speechEngines } from "../../data/cadence-release";
---

<section
  id="engines"
  class="cadence-engines"
  aria-labelledby="cadence-engines-heading"
>
  <header class="cadence-engines__bar">
    <h3 id="cadence-engines-heading">On-device speech engines (100% offline)</h3>
    <span>Switch engines anytime in Settings → Voice &amp; Speech</span>
  </header>

  <div class="cadence-engines__table-wrap">
    <table class="cadence-engines__table">
      <thead>
        <tr>
          <th scope="col">Engine</th>
          <th scope="col">Download</th>
          <th scope="col">Latency</th>
          <th scope="col">Hardware</th>
          <th scope="col">Strengths</th>
        </tr>
      </thead>
      <tbody>
        {speechEngines.map((engine) => (
          <tr>
            <th scope="row" data-label="Engine">
              <span class="cadence-engines__name">
                {engine.name}
                {engine.badge && (
                  <span class="cadence-engines__badge">{engine.badge}</span>
                )}
              </span>
            </th>
            <td data-label="Download" class="cadence-engines__mono">
              {engine.download}
            </td>
            <td data-label="Latency" class="cadence-engines__mono">
              {engine.latency}
            </td>
            <td data-label="Hardware">{engine.hardware}</td>
            <td data-label="Strengths">{engine.highlights}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .cadence-engines {
    --cadence-breakout-width: min(calc(100vw - 2.5rem), 64rem);
    position: relative;
    left: 50%;
    width: var(--cadence-breakout-width);
    max-width: none;
    margin: clamp(2.25rem, 5vw, 3.5rem) 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper-subtle);
    transform: translateX(-50%);
    scroll-margin-top: 5.5rem;
  }

  .cadence-engines__bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: 0.82rem;
  }

  .cadence-engines__bar h3 {
    margin: 0;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .cadence-engines__table-wrap {
    background: var(--paper);
  }

  .cadence-engines__table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.87rem;
    line-height: 1.5;
  }

  .cadence-engines__table thead th {
    padding: 0.72rem 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-muted);
    background: var(--paper-subtle);
    font-size: 0.76rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .cadence-engines__table tbody th,
  .cadence-engines__table tbody td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
    color: var(--ink-soft);
  }

  .cadence-engines__table tbody tr:last-child th,
  .cadence-engines__table tbody tr:last-child td {
    border-bottom: 0;
  }

  .cadence-engines__table tbody th {
    color: var(--ink);
    font-weight: 600;
  }

  .cadence-engines__name {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
  }

  .cadence-engines__badge {
    padding: 0.08rem 0.45rem;
    border: 1px solid var(--signal-line);
    border-radius: 999px;
    color: var(--signal);
    background: var(--signal-soft);
    font-size: 0.72rem;
    font-weight: 550;
  }

  .cadence-engines__mono {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .cadence-engines {
      --cadence-breakout-width: calc(100vw - 1.5rem);
    }

    .cadence-engines__table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .cadence-engines__table,
    .cadence-engines__table tbody,
    .cadence-engines__table tr,
    .cadence-engines__table th,
    .cadence-engines__table td {
      display: block;
      width: 100%;
    }

    .cadence-engines__table tbody tr {
      padding: 0.95rem 1rem;
      border-bottom: 1px solid var(--line);
    }

    .cadence-engines__table tbody tr:last-child {
      border-bottom: 0;
    }

    .cadence-engines__table tbody th,
    .cadence-engines__table tbody td {
      display: grid;
      grid-template-columns: 6.2rem minmax(0, 1fr);
      gap: 0.6rem;
      padding: 0.28rem 0;
      border: 0;
    }

    .cadence-engines__table tbody th {
      grid-template-columns: 1fr;
      padding-bottom: 0.45rem;
      font-size: 0.94rem;
    }

    .cadence-engines__table tbody td::before {
      content: attr(data-label);
      color: var(--ink-muted);
      font-family: var(--font-sans);
      font-size: 0.76rem;
      font-weight: 600;
    }

    .cadence-engines__mono {
      white-space: normal;
    }
  }
</style>
