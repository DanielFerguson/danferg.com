---
import { formattingTips, shortcutGroups } from "../../data/cadence-release";
---

<section
  id="shortcuts"
  class="cadence-reference"
  aria-labelledby="cadence-reference-heading"
>
  <header class="cadence-reference__bar">
    <h3 id="cadence-reference-heading">Script syntax and keyboard shortcuts</h3>
    <span>Markdown cues in the editor, global controls while recording</span>
  </header>

  <div class="cadence-syntax">
    {formattingTips.map((tip) => (
      <div class="cadence-syntax__item">
        <div class="cadence-syntax__head">
          <code class="cadence-syntax__token">{tip.token}</code>
          <span
            class:list={[
              "cadence-syntax__preview",
              `cadence-syntax__preview--${tip.previewKind}`,
            ]}
          >
            {tip.previewLabel}
          </span>
        </div>
        <p>{tip.description}</p>
      </div>
    ))}
  </div>

  <div class="cadence-shortcuts">
    {shortcutGroups.map((group) => (
      <div class="cadence-shortcuts__col">
        <div class="cadence-shortcuts__head">
          <h4>{group.title}</h4>
          <span>{group.note}</span>
        </div>

        <dl class="cadence-shortcuts__list">
          {group.items.map((item) => (
            <div class="cadence-shortcuts__row">
              <dt>
                <span class="cadence-keys">
                  {item.keys.map((key) =>
                    key === "/" ? (
                      <span class="cadence-keys__sep" aria-hidden="true">/</span>
                    ) : (
                      <kbd>{key}</kbd>
                    ),
                  )}
                </span>
              </dt>
              <dd>{item.action}</dd>
            </div>
          ))}
        </dl>
      </div>
    ))}
  </div>
</section>

<style>
  .cadence-reference {
    --cadence-breakout-width: min(calc(100vw - 2.5rem), 64rem);
    position: relative;
    left: 50%;
    width: var(--cadence-breakout-width);
    max-width: none;
    margin: clamp(2.25rem, 5vw, 3.5rem) 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper-subtle);
    transform: translateX(-50%);
    scroll-margin-top: 5.5rem;
  }

  .cadence-reference__bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: 0.82rem;
  }

  .cadence-reference__bar h3 {
    margin: 0;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .cadence-syntax {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    border-bottom: 1px solid var(--line);
    background: var(--line);
  }

  .cadence-syntax__item {
    padding: 1rem 1.2rem;
    background: var(--paper);
  }

  .cadence-syntax__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.7rem;
    align-items: center;
    justify-content: space-between;
  }

  .cadence-syntax__token {
    font-family: var(--font-mono);
    font-size: 0.8rem !important;
  }

  .cadence-syntax__preview {
    font-size: 0.74rem;
    line-height: 1.2;
  }

  .cadence-syntax__preview--heading {
    color: #15803d;
    font-family: var(--font-mono);
    font-weight: 650;
    letter-spacing: 0.06em;
  }

  :global(:root[data-theme="dark"]) .cadence-syntax__preview--heading {
    color: #34d399;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .cadence-syntax__preview--heading {
      color: #34d399;
    }
  }

  .cadence-syntax__preview--cue {
    padding: 0.16rem 0.45rem;
    border: 1px solid rgb(217 119 6 / 35%);
    border-radius: var(--radius-sm);
    color: light-dark(#92400e, #fbbf24);
    background: light-dark(rgb(251 191 36 / 18%), rgb(251 191 36 / 14%));
    font-weight: 600;
  }

  .cadence-syntax__preview--emphasis {
    padding: 0.14rem 0.45rem;
    border-radius: var(--radius-sm);
    color: #ffffff;
    background: #171522;
    font-weight: 650;
  }

  .cadence-syntax__preview--import {
    color: var(--ink-muted);
    font-family: var(--font-mono);
  }

  .cadence-syntax__item p {
    margin: 0.55rem 0 0;
    color: var(--ink-soft);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .cadence-shortcuts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
  }

  .cadence-shortcuts__col {
    background: var(--paper);
  }

  .cadence-shortcuts__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.78rem 1.2rem;
    border-bottom: 1px solid var(--line);
    background: var(--paper-subtle);
  }

  .cadence-shortcuts__head h4 {
    margin: 0;
    color: var(--ink);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .cadence-shortcuts__head span {
    color: var(--ink-muted);
    font-size: 0.77rem;
  }

  .cadence-shortcuts__list {
    margin: 0;
    padding: 0.35rem 0;
  }

  .cadence-shortcuts__row {
    display: grid;
    grid-template-columns: minmax(6.2rem, auto) minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    padding: 0.48rem 1.2rem;
  }

  .cadence-shortcuts__row + .cadence-shortcuts__row {
    border-top: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }

  .cadence-shortcuts__row dt {
    margin: 0;
  }

  .cadence-shortcuts__row dd {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .cadence-keys {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.22rem;
    align-items: center;
  }

  .cadence-keys kbd {
    display: inline-flex;
    min-width: 1.45rem;
    height: 1.45rem;
    padding: 0 0.36rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-strong);
    border-bottom-width: 2px;
    border-radius: var(--radius-sm);
    color: var(--ink);
    background: var(--paper-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 550;
    line-height: 1;
  }

  .cadence-keys__sep {
    color: var(--ink-muted);
    font-size: 0.75rem;
  }

  @media (max-width: 820px) {
    .cadence-reference {
      --cadence-breakout-width: calc(100vw - 1.5rem);
    }

    .cadence-syntax,
    .cadence-shortcuts {
      grid-template-columns: 1fr;
    }
  }
</style>
