---
import {
  cadenceRelease,
  changelogReleases,
  storageLocations,
} from "../../data/cadence-release";
---

<section
  id="release-notes"
  class="cadence-notes"
  aria-labelledby="cadence-notes-heading"
>
  <header class="cadence-notes__bar">
    <h3 id="cadence-notes-heading">Release notes and local storage</h3>
    <span>Current build: v{cadenceRelease.version} ({cadenceRelease.releaseDateLabel})</span>
  </header>

  <div class="cadence-notes__body">
    {changelogReleases.map((release) => (
      <div class="cadence-changelog">
        <div class="cadence-changelog__head">
          <span class="cadence-changelog__ver">v{release.version}</span>
          <time datetime={release.date}>{release.dateLabel}</time>
          <p>{release.summary}</p>
        </div>

        <ul class="cadence-changelog__list">
          {release.items.map((item) => (
            <li>
              <strong>{item.title}</strong>
              <span>{item.detail}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <div class="cadence-storage">
      <div class="cadence-storage__head">
        <h4>Where your files live on disk</h4>
        <span>Everything stays local to your Mac</span>
      </div>

      <dl class="cadence-storage__list">
        {storageLocations.map((loc) => (
          <div>
            <dt>{loc.label}</dt>
            <dd>
              <code>{loc.path}</code>
              <span>{loc.detail}</span>
            </dd>
          </div>
        ))}
      </dl>

      <div class="cadence-privacy-note">
        <h4>Screen-share and ScreenCaptureKit note</h4>
        <p>
          <strong>Hide from Screen Shares &amp; Recordings</strong> is on by default
          (<code>NSWindow.sharingType = .none</code>), which keeps the notch overlay out
          of macOS screenshots and legacy capture APIs. On macOS 15+, Apple treats that
          flag as a legacy hint for modern <code>ScreenCaptureKit</code> full-display
          recorders such as Loom, Screen Studio, OBS, and Zoom. Run a quick 5-second test
          recording before an important take; if full-screen capture still shows the
          overlay, record a single window, crop the region, or exclude Cadence in your
          recorder's app list.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .cadence-notes {
    --cadence-breakout-width: min(calc(100vw - 2.5rem), 64rem);
    position: relative;
    left: 50%;
    width: var(--cadence-breakout-width);
    max-width: none;
    margin: clamp(2.25rem, 5vw, 3.5rem) 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper-subtle);
    transform: translateX(-50%);
    scroll-margin-top: 5.5rem;
  }

  .cadence-notes__bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: 0.82rem;
  }

  .cadence-notes__bar h3 {
    margin: 0;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .cadence-notes__body {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 1px;
    background: var(--line);
  }

  .cadence-changelog,
  .cadence-storage {
    padding: clamp(1.1rem, 2.2vw, 1.45rem);
    background: var(--paper);
  }

  .cadence-changelog__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    align-items: baseline;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .cadence-changelog__ver {
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--signal-line);
    border-radius: 999px;
    color: var(--signal);
    background: var(--signal-soft);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .cadence-changelog__head time {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .cadence-changelog__head p {
    flex-basis: 100%;
    margin: 0.25rem 0 0;
    color: var(--ink-soft);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .cadence-changelog__list {
    margin: 0.95rem 0 0;
    padding: 0;
    list-style: none;
  }

  .cadence-changelog__list li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0;
  }

  .cadence-changelog__list li + li {
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px solid color-mix(in srgb, var(--line) 75%, transparent);
  }

  .cadence-changelog__list strong {
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .cadence-changelog__list span {
    color: var(--ink-soft);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .cadence-storage__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .cadence-storage__head h4,
  .cadence-privacy-note h4 {
    margin: 0;
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .cadence-storage__head span {
    color: var(--ink-muted);
    font-size: 0.78rem;
  }

  .cadence-storage__list {
    margin: 0.85rem 0 0;
  }

  .cadence-storage__list > div + div {
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px solid color-mix(in srgb, var(--line) 75%, transparent);
  }

  .cadence-storage__list dt {
    color: var(--ink);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .cadence-storage__list dd {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0.25rem 0 0;
  }

  .cadence-storage__list code {
    font-size: 0.76rem !important;
    overflow-wrap: anywhere;
  }

  .cadence-storage__list span {
    color: var(--ink-soft);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .cadence-privacy-note {
    margin-top: 1.25rem;
    padding: 0.95rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper-subtle);
  }

  .cadence-privacy-note p {
    margin: 0.45rem 0 0;
    color: var(--ink-soft);
    font-size: 0.83rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .cadence-notes {
      --cadence-breakout-width: calc(100vw - 1.5rem);
    }

    .cadence-notes__body {
      grid-template-columns: 1fr;
    }
  }
</style>
