---
import { Image } from "astro:assets";
import headshot from "../assets/images/dan-ferg-headshot.webp";
---

<aside class="author-note" aria-labelledby="author-note-title" data-motion-reveal>
  <Image
    class="author-note__photo"
    src={headshot}
    alt="Dan Ferg"
    width={96}
    height={96}
    densities={[1, 2]}
    loading="lazy"
  />
  <div>
    <h2 id="author-note-title"><a href="/about" rel="author">Dan Ferg</a></h2>
    <p>
      Melbourne-based software builder and Head of Innovation at Spatial Media.
      I founded Helping Group after the 2020 bushfires and led Communiti Labs
      from 2023 to 2026.
    </p>
    <p class="author-note__links">
      <a href="/about">More about me <span aria-hidden="true">→</span></a>
      <a href="/consulting">Availability &amp; referrals <span aria-hidden="true">→</span></a>
    </p>
  </div>
</aside>

<style>
  .author-note {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1rem, 2.5vw, 1.5rem);
    align-items: start;
    max-width: 44rem;
    margin: 3.5rem auto 0;
    padding: clamp(1.15rem, 2.5vw, 1.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper-subtle);
  }

  .author-note__photo {
    width: 4rem;
    height: 4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    object-fit: cover;
  }

  h2 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--signal);
  }

  p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .author-note__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 0.85rem;
    font-size: 0.86rem;
  }

  .author-note__links a {
    color: var(--signal);
    font-weight: 500;
    text-decoration: none;
  }

  .author-note__links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 520px) {
    .author-note {
      grid-template-columns: 1fr;
    }
  }
</style>
