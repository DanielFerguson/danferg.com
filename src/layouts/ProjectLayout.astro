---
import type SEO from "types/SEO";
import { getImage, Picture } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import NavBar from "@components/NavBar.astro";
import ConversionEndcap from "@components/ConversionEndcap.astro";
import {
  getProjectExternalUrl,
  getProjectScreenshot,
} from "../utils/project-assets";
import { getNextProject } from "../data/project-journey";
import { createContactMailto } from "../utils/contact-links";
import { pageTitle } from "../utils/seo";

const { frontmatter } = Astro.props;
const projectUrl = getProjectExternalUrl(frontmatter);
const siteOrigin = Astro.site?.origin ?? "https://danferg.com";
const parsedProjectUrl = projectUrl ? new URL(projectUrl, siteOrigin) : null;
const projectLinkIsExternal =
  parsedProjectUrl !== null && parsedProjectUrl.origin !== siteOrigin;
const projectLinkHref =
  parsedProjectUrl && !projectLinkIsExternal
    ? `${parsedProjectUrl.pathname}${parsedProjectUrl.search}${parsedProjectUrl.hash}`
    : projectUrl;
const projectLinkLabel = frontmatter.externalLabel || "Visit project";
const projectScreenshot = getProjectScreenshot(frontmatter.imageKey);
const projectSocialImage = await getImage({
  src: projectScreenshot,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "webp",
  quality: 80,
});
const screenshotAlt =
  frontmatter.imageAlt || `${frontmatter.title} product interface screenshot`;
const caseStudyLabel = frontmatter.caseStudyLabel || "Case study";
const nextProject = getNextProject(frontmatter.canonicalUrl);
const contactTitle = `Interested in ${frontmatter.title}—or how it was built?`;
const contactDescription =
  "I’m full-time as Head of Innovation at Spatial Media with very limited consulting availability—always glad to chat about the work, or refer you to trusted people in my network.";
const contactMailto = createContactMailto({
  subject: `Enquiry after reading the ${frontmatter.title} case study`,
  body: `G'day Dan,\n\nI read your ${frontmatter.title} case study and would like to chat.\n\nA little context:\n`,
});
const endcapActions = [
  {
    meta: "Get in touch",
    label: "Ask about this project",
    href: contactMailto,
  },
  ...(projectUrl
    ? [
        {
          meta: "Project link",
          label: projectLinkLabel,
          href: projectLinkHref,
          external: projectLinkIsExternal,
        },
      ]
    : []),
  {
    meta: "Next project",
    label: nextProject.title,
    href: nextProject.href,
    description: nextProject.description,
  },
];

const SEO: SEO & {
  headline: string;
  articleSection: string;
  publishedDate?: string;
  modifiedDate?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
} = {
  title: pageTitle(frontmatter.title, frontmatter.seoTitle),
  headline: frontmatter.title,
  description: frontmatter.description,
  imageUrl: projectSocialImage.src,
  imageAlt: screenshotAlt,
  imageWidth: 1200,
  imageHeight: 630,
  imageType: "image/webp",
  openGraph: { type: "article" },
  canonicalUrl: frontmatter.canonicalUrl,
  // Unlisted case studies stay reachable by link but out of search results.
  robots: frontmatter.visible === false ? "noindex,follow" : undefined,
  schemaType: "CreativeWork",
  publishedDate: frontmatter.publishedDate || frontmatter.date,
  modifiedDate: frontmatter.modifiedDate || frontmatter.updatedDate,
  articleSection: "Case studies",
  breadcrumbs: [
    { name: "Home", url: "/" },
    { name: "Projects", url: "/projects" },
    { name: frontmatter.title, url: frontmatter.canonicalUrl },
  ],
};
---

<BaseLayout {...SEO}>
  <NavBar />
  <main id="main-content">
    <section class="band page-hero-band">
      <div class="band__frame project-header" data-motion-intro-group>
        <p class="project-header__back" data-motion-intro-item>
          <a href="/projects"><span aria-hidden="true">←</span> Projects</a>
        </p>

        <div class="project-header__main" data-motion-intro-item>
          <p class="page-hero__eyebrow">{caseStudyLabel}</p>
          <h1>{frontmatter.title}</h1>
          <p class="project-header__lede">{frontmatter.description}</p>
          {projectUrl && (
            <div class="project-header__actions">
              <a
                class="btn btn--secondary"
                href={projectLinkHref}
                target={projectLinkIsExternal ? "_blank" : undefined}
                rel={projectLinkIsExternal ? "noopener noreferrer" : undefined}
                data-astro-prefetch={projectLinkIsExternal ? undefined : "hover"}
                data-motion-interactive
              >
                {projectLinkLabel} <span aria-hidden="true" data-motion-arrow>{projectLinkIsExternal ? "↗" : "→"}</span>
              </a>
            </div>
          )}
        </div>

        <dl class="project-meta" data-motion-intro-item>
          {frontmatter.period && <div><dt>Period</dt><dd>{frontmatter.period}</dd></div>}
          {frontmatter.status && <div><dt>Status</dt><dd>{frontmatter.status}</dd></div>}
          {frontmatter.role && <div><dt>Role</dt><dd>{frontmatter.role}</dd></div>}
          {frontmatter.tags?.length > 0 && <div><dt>Disciplines</dt><dd>{frontmatter.tags.join(" · ")}</dd></div>}
        </dl>
      </div>
    </section>

    <section class="band">
      <div class="band__frame project-body">
        {!frontmatter.hideScreenshot && (
          <div class="project-visual" data-motion-reveal data-motion-scale>
            <Picture
              src={projectScreenshot}
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              alt={screenshotAlt}
              widths={[640, 960, 1280]}
              sizes="(min-width: 1280px) 1080px, calc(100vw - 40px)"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        )}

        <article class="prose-shell article-prose" data-motion-reveal data-pagefind-body>
          <slot />
        </article>
      </div>
    </section>

    <ConversionEndcap
      headingId="project-next-step"
      eyebrow="Keep exploring"
      title={contactTitle}
      description={contactDescription}
      actions={endcapActions}
    />
  </main>
</BaseLayout>


<style>
  .project-header {
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(2.25rem, 4vw, 3.25rem);
  }

  .project-header__back {
    margin: 0 0 clamp(1.5rem, 3vw, 2.25rem);
    font-size: 0.88rem;
  }

  .project-header__back a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 140ms ease;
  }

  .project-header__back a:hover {
    color: var(--signal);
  }

  .project-header__main {
    max-width: 44rem;
  }

  h1 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.35rem, 5vw, 3.85rem);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.035em;
  }

  .project-header__lede {
    max-width: 40rem;
    margin: 1.15rem 0 0;
    color: var(--ink-soft);
    font-size: clamp(1.02rem, 1.4vw, 1.12rem);
    line-height: 1.65;
  }

  .project-header__actions {
    margin-top: 1.5rem;
  }

  .project-meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem 0;
    margin: clamp(2.25rem, 4vw, 3rem) 0 0;
    padding: 1.35rem 0 0;
    border-top: 1px solid var(--line);
  }

  .project-meta div {
    padding-right: 1.25rem;
  }

  .project-meta div + div {
    padding-left: 1.25rem;
    border-left: 1px solid var(--line);
  }

  .project-meta dt {
    color: var(--ink-muted);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .project-meta dd {
    margin: 0.35rem 0 0;
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .project-body {
    padding-block: clamp(2.5rem, 5vw, 3.75rem) clamp(3.5rem, 7vw, 5.5rem);
  }

  .project-visual {
    margin: 0 0 clamp(2.5rem, 5vw, 3.75rem);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper-subtle);
  }

  .project-visual :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .project-body :global(.article-prose) {
    margin-inline: auto;
  }

  @media (max-width: 780px) {
    .project-meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0;
    }

    .project-meta div {
      padding: 0.85rem 0.75rem 0.85rem 0;
    }

    .project-meta div + div {
      padding-left: 0;
      border-left: 0;
    }

    .project-meta div:nth-child(even) {
      padding-left: 1rem;
      padding-right: 0;
      border-left: 1px solid var(--line);
    }

    .project-meta div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
</style>
