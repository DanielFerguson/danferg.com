---
import type SEO from "types/SEO";
import BaseLayout from "./BaseLayout.astro";
import NavBar from "@components/NavBar.astro";
import EditorialEndcap from "@components/EditorialEndcap.astro";
import RelatedContent from "@components/RelatedContent.astro";
import ArticleAudioPlayer from "@components/ArticleAudioPlayer.astro";
import ArticleTags from "@components/ArticleTags.astro";
import SeriesNav from "@components/SeriesNav.astro";
import ArticleSummary from "@components/ArticleSummary.astro";
import ArticleContents from "@components/ArticleContents.astro";
import AuthorNote from "@components/AuthorNote.astro";
import { getCollection, render } from "astro:content";
import getReadingTime from "reading-time";
import { latinFontFileUrl } from "../utils/fonts";
import { pageTitle } from "../utils/seo";
import { FEED_CONTENT_END, FEED_CONTENT_START } from "../utils/feed-markers";
import { extractCitationUrls } from "../utils/citations";
import { tags as tagCatalogue, type TagId } from "../data/taxonomy";

const { frontmatter } = Astro.props;
const isDraft = frontmatter.draft === true;
const formatDate = (date: string) =>
  new Intl.DateTimeFormat("en-AU", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  }).format(new Date(`${date}T00:00:00`));
const modifiedDate = frontmatter.modifiedDate || frontmatter.updatedDate;
const series = frontmatter.series as { id: "working-out-my-vote"; part: number } | undefined;
const tags = (frontmatter.tags ?? []) as TagId[];

// The collection entry supplies the raw body (for word count and cited
// sources) and the heading outline, for both .md and .mdx articles.
const entries = [
  ...(await getCollection("articles")),
  ...(import.meta.env.DEV ? await getCollection("articleDrafts") : []),
];
const entry = entries.find(
  (candidate) => candidate.data.canonicalUrl === frontmatter.canonicalUrl,
);
const body = entry?.body ?? "";
const wordCount = getReadingTime(body).words;
const citationUrls = extractCitationUrls(body);
const headings = entry ? (await render(entry)).headings : [];
const sections = headings
  .filter((heading) => heading.depth === 2)
  .map((heading) => [heading.slug, heading.text] as [string, string]);
// Long reads get a contents list, unless the article places its own.
const showContents =
  wordCount >= 1800 &&
  sections.length >= 5 &&
  !/<(ArticleContents|ElectionGuideContents)\b/.test(body);
// Personal essays and election writing end with ways to follow along rather
// than a consulting pitch.
const endcapVariant = tags.some((tag) =>
  ["reflections", "politics", "victorian-election-2026"].includes(tag),
)
  ? "follow"
  : "consulting";

const SEO: SEO & {
  headline: string;
  articleSection: string;
  keywords?: string[];
  abstract?: string;
  wordCount?: number;
  modifiedDate?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
} = {
  title: pageTitle(frontmatter.title, frontmatter.seoTitle),
  headline: frontmatter.title,
  description: frontmatter.description,
  imageUrl: frontmatter.imageUrl,
  imageUrls: frontmatter.imageUrls,
  imageAlt:
    frontmatter.imageAlt || `${frontmatter.title} article cover image`,
  imageWidth: frontmatter.imageWidth,
  imageHeight: frontmatter.imageHeight,
  imageType: frontmatter.imageType,
  openGraph: { type: "article" },
  canonicalUrl: frontmatter.canonicalUrl,
  schemaType: "Article",
  publishedDate: frontmatter.date,
  modifiedDate,
  articleSection: "Articles",
  citationUrls,
  keywords: tags.map((tag) => tagCatalogue[tag].label),
  abstract: frontmatter.summary,
  wordCount,
  robots: isDraft ? "noindex,nofollow,noarchive" : undefined,
  breadcrumbs: [
    { name: "Home", url: "/" },
    { name: "Articles", url: "/articles" },
    { name: frontmatter.title, url: frontmatter.canonicalUrl },
  ],
};
---

<BaseLayout {...SEO}>
  {/* Running prose in articles reads in Geist; the rest of the site stays on Geist Mono. */}
  <link
    slot="head"
    rel="preload"
    href={latinFontFileUrl("--font-sans")}
    as="font"
    type="font/woff2"
    crossorigin
  />
  <NavBar />
  <main id="main-content">
    <header class="site-container story-header" data-motion-intro-group>
      <p class="story-header__path" data-motion-intro-item><a href="/">HOME</a> / <a href="/articles">ARTICLES</a> / {isDraft ? "DRAFT" : "FILE"}</p>
      <div class="story-header__grid" data-motion-intro-item>
        <div>
          <p class="story-header__type">
            ARTICLE // BY <a href="/about" rel="author">DAN FERG</a> // {isDraft ? "LOCAL DRAFT" : "PUBLISHED"} <time datetime={frontmatter.date}>{formatDate(frontmatter.date).toUpperCase()}</time>
            {modifiedDate && modifiedDate !== frontmatter.date && <> // UPDATED <time datetime={modifiedDate}>{formatDate(modifiedDate).toUpperCase()}</time></>}
          </p>
          <h1>{frontmatter.title}</h1>
        </div>
        <div class="story-header__aside">
          <p class="story-header__description">{frontmatter.description}</p>
          <ArticleTags tags={frontmatter.tags} pagefind />
        </div>
      </div>
    </header>
    {frontmatter.audio && (
      <ArticleAudioPlayer audio={frontmatter.audio} title={frontmatter.title} />
    )}
    <hr class="site-container ascii-rule" />
    <article class="prose-shell article-prose" data-motion-reveal data-pagefind-body>
      {series && <SeriesNav id={series.id} part={series.part} currentPath={frontmatter.canonicalUrl} variant="compact" />}
      {frontmatter.summary && <ArticleSummary summary={frontmatter.summary} />}
      {showContents && <ArticleContents sections={sections} />}
      {/* Marks the body for feeds (see src/utils/feed-items.ts). */}
      <Fragment set:html={FEED_CONTENT_START} />
      <slot />
      <Fragment set:html={FEED_CONTENT_END} />
      {series && <SeriesNav id={series.id} part={series.part} currentPath={frontmatter.canonicalUrl} />}
    </article>
    <AuthorNote />
    <RelatedContent currentPath={frontmatter.canonicalUrl} kind="articles" tags={tags} />
    <EditorialEndcap sourceTitle={frontmatter.title} variant={endcapVariant} />
  </main>
</BaseLayout>

<style>
  .story-header {
    padding-block: clamp(2.5rem, 5vw, 4.75rem) clamp(2.25rem, 4vw, 3.75rem);
  }

  .story-header__path,
  .story-header__type {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
  }

  .story-header__path {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .story-header__path a {
    color: var(--ink);
    text-underline-offset: 0.2em;
  }

  .story-header__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.65fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: end;
  }

  .story-header__type {
    margin-bottom: 0.85rem;
    color: var(--signal);
    font-weight: 750;
  }

  .story-header__type a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  h1 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.25rem, 5.5vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.07em;
  }

  .story-header__aside {
    display: grid;
    gap: 0.9rem;
  }

  .story-header__description {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  @media (max-width: 720px) {
    .story-header__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { initializeMermaidDiagrams } from "../scripts/mermaid-diagrams";

  void initializeMermaidDiagrams();
</script>
