---
import type SEO from "types/SEO";
import BaseLayout from "./BaseLayout.astro";
import NavBar from "@components/NavBar.astro";
import EditorialEndcap from "@components/EditorialEndcap.astro";
import RelatedContent from "@components/RelatedContent.astro";
import ArticleAudioPlayer from "@components/ArticleAudioPlayer.astro";
import ArticleTags from "@components/ArticleTags.astro";
import SeriesNav from "@components/SeriesNav.astro";
import ArticleSummary from "@components/ArticleSummary.astro";
import ArticleContents from "@components/ArticleContents.astro";
import AuthorNote from "@components/AuthorNote.astro";
import { getCollection, render } from "astro:content";
import getReadingTime from "reading-time";
import { pageTitle } from "../utils/seo";
import { FEED_CONTENT_END, FEED_CONTENT_START } from "../utils/feed-markers";
import { extractCitationUrls } from "../utils/citations";
import { tags as tagCatalogue, type TagId } from "../data/taxonomy";

const { frontmatter } = Astro.props;
const isDraft = frontmatter.draft === true;
const formatDate = (date: string) =>
  new Intl.DateTimeFormat("en-AU", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(new Date(`${date}T00:00:00`));
const modifiedDate = frontmatter.modifiedDate || frontmatter.updatedDate;
const series = frontmatter.series as
  | { id: "working-out-my-vote"; part: number }
  | undefined;
const tags = (frontmatter.tags ?? []) as TagId[];

const entries = [
  ...(await getCollection("articles")),
  ...(import.meta.env.DEV ? await getCollection("articleDrafts") : []),
];
const entry = entries.find(
  (candidate) => candidate.data.canonicalUrl === frontmatter.canonicalUrl,
);
const body = entry?.body ?? "";
const readingStats = getReadingTime(body);
const wordCount = readingStats.words;
const readingTimeText = readingStats.text;
const citationUrls = extractCitationUrls(body);
const headings = entry ? (await render(entry)).headings : [];
const sections = headings
  .filter((heading) => heading.depth === 2)
  .map((heading) => [heading.slug, heading.text] as [string, string]);
const showContents =
  frontmatter.showContents !== false &&
  wordCount >= 1800 &&
  sections.length >= 5 &&
  !/<(ArticleContents|ElectionGuideContents)\b/.test(body);
const showAuthorNote = frontmatter.showAuthorNote !== false;
const endcapVariant = tags.some((tag) =>
  ["reflections", "politics", "victorian-election-2026"].includes(tag),
)
  ? "follow"
  : "consulting";

const SEO: SEO & {
  headline: string;
  articleSection: string;
  keywords?: string[];
  abstract?: string;
  wordCount?: number;
  modifiedDate?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
} = {
  title: pageTitle(frontmatter.title, frontmatter.seoTitle),
  headline: frontmatter.title,
  description: frontmatter.description,
  imageUrl: frontmatter.imageUrl,
  imageUrls: frontmatter.imageUrls,
  imageAlt:
    frontmatter.imageAlt || `${frontmatter.title} article cover image`,
  imageWidth: frontmatter.imageWidth,
  imageHeight: frontmatter.imageHeight,
  imageType: frontmatter.imageType,
  openGraph: { type: "article" },
  canonicalUrl: frontmatter.canonicalUrl,
  schemaType: "Article",
  publishedDate: frontmatter.date,
  modifiedDate,
  articleSection: "Articles",
  citationUrls,
  keywords: tags.map((tag) => tagCatalogue[tag].label),
  abstract: frontmatter.summary,
  wordCount,
  robots: isDraft ? "noindex,nofollow,noarchive" : undefined,
  breadcrumbs: [
    { name: "Home", url: "/" },
    { name: "Articles", url: "/articles" },
    { name: frontmatter.title, url: frontmatter.canonicalUrl },
  ],
};
---

<BaseLayout {...SEO}>
  <NavBar />

  <main id="main-content">
    <header class="band page-hero-band">
      <div class="band__frame story-header">
        <div class="story-header__inner" data-motion-intro-group>
          <p class="story-header__back" data-motion-intro-item>
            <a href="/articles" data-astro-prefetch="hover">← Articles</a>
          </p>

          <p class="story-header__meta" data-motion-intro-item>
            {isDraft && <span class="story-header__draft">Draft</span>}
            <time datetime={frontmatter.date}>
              {formatDate(frontmatter.date)}
            </time>
            {
              modifiedDate && modifiedDate !== frontmatter.date && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>
                    Updated{" "}
                    <time datetime={modifiedDate}>
                      {formatDate(modifiedDate)}
                    </time>
                  </span>
                </>
              )
            }
            <span aria-hidden="true">·</span>
            <span>{readingTimeText}</span>
          </p>

          <h1 data-motion-intro-item>{frontmatter.title}</h1>

          {
            frontmatter.description && (
              <p class="story-header__lede" data-motion-intro-item>
                {frontmatter.description}
              </p>
            )
          }

          {
            tags.length > 0 && (
              <div class="story-header__tags" data-motion-intro-item>
                <ArticleTags tags={frontmatter.tags} pagefind />
              </div>
            )
          }
        </div>
      </div>
    </header>

    <div class="band">
      <div class="band__frame article-body-frame">
        <article
          class="prose-shell article-prose"
          data-pagefind-body
        >
          {
            frontmatter.audio && (
              <ArticleAudioPlayer
                audio={frontmatter.audio}
                title={frontmatter.title}
              />
            )
          }
          {
            series && (
              <SeriesNav
                id={series.id}
                part={series.part}
                currentPath={frontmatter.canonicalUrl}
                variant="compact"
              />
            )
          }
          {
            frontmatter.summary && (
              <ArticleSummary summary={frontmatter.summary} />
            )
          }
          {showContents && <ArticleContents sections={sections} />}
          {/* Marks the body for feeds (see src/utils/feed-items.ts). */}
          <Fragment set:html={FEED_CONTENT_START} />
          <slot />
          <Fragment set:html={FEED_CONTENT_END} />
          {
            series && (
              <SeriesNav
                id={series.id}
                part={series.part}
                currentPath={frontmatter.canonicalUrl}
              />
            )
          }
        </article>

        {showAuthorNote && <AuthorNote />}
      </div>
    </div>

    <RelatedContent
      currentPath={frontmatter.canonicalUrl}
      kind="articles"
      tags={tags}
    />
    <EditorialEndcap sourceTitle={frontmatter.title} variant={endcapVariant} />
  </main>
</BaseLayout>

<style>
  .story-header {
    padding-block: clamp(2.5rem, 5vw, 4.25rem);
  }

  .story-header__inner {
    max-width: 44rem;
    margin-inline: auto;
  }

  .story-header__back {
    margin: 0 0 1.5rem;
    font-size: 0.875rem;
  }

  .story-header__back a {
    color: var(--ink-muted);
    font-weight: 500;
    text-decoration: none;
  }

  .story-header__back a:is(:hover, :focus-visible) {
    color: var(--signal);
  }

  .story-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
    margin: 0 0 0.85rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .story-header__draft {
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--signal-line);
    border-radius: 999px;
    color: var(--signal);
    background: var(--signal-soft);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
  }

  h1 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.032em;
  }

  .story-header__lede {
    margin: 1.15rem 0 0;
    color: var(--ink-soft);
    font-size: clamp(1.04rem, 1.5vw, 1.16rem);
    line-height: 1.6;
  }

  .story-header__tags {
    margin-top: 1.35rem;
  }

  .article-body-frame {
    padding-block: clamp(2rem, 4.5vw, 3.5rem) clamp(3rem, 6vw, 4.5rem);
  }

  .article-body-frame .prose-shell {
    width: 100%;
    max-width: 44rem;
    padding-block: 0;
  }
</style>

<script>
  import { initializeMermaidDiagrams } from "../scripts/mermaid-diagrams";

  void initializeMermaidDiagrams();
  document.addEventListener("astro:page-load", () => {
    void initializeMermaidDiagrams();
  });
</script>
