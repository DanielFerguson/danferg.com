---
import type SEO from "types/SEO";
import BaseLayout from "@layouts/BaseLayout.astro";
import NavBar from "@components/NavBar.astro";

const canonicalPath = "/chef";
const sourceUrl = "https://github.com/DanielFerguson/chef-skills";
const releaseUrl = `${sourceUrl}/releases/tag/v0.2.0`;
const releaseAssetUrl = `${sourceUrl}/releases/download/v0.2.0`;
const pluginDownloadUrl = `${releaseAssetUrl}/chef-plugin-0.2.0.zip`;
const skillsDownloadUrl = `${releaseAssetUrl}/chef-agent-skills-0.2.0.zip`;
const checksumsUrl = `${releaseAssetUrl}/SHA256SUMS`;
const archivedReleaseUrl = `${sourceUrl}/releases/tag/v0.1.0`;
const SEO: SEO = {
  title: "Chef — conversational meal planning | Dan Ferg",
  headline: "Plan dinner naturally. Keep the context you actually want.",
  description: "Chef is a conversational meal-planning assistant with transparent local Markdown memory, practical recipes, nutrition estimates and controlled grocery preparation.",
  imageUrl: "/images/og-default.png",
  imageAlt: "Chef — conversational meal planning Agent Skills by Dan Ferg",
  openGraph: { type: "website" },
  canonicalUrl: canonicalPath,
  schemaType: "SoftwareApplication",
  modifiedDate: "2026-08-24",
  breadcrumbs: [
    { name: "Home", url: "/" },
    { name: "Chef", url: canonicalPath },
  ],
  jsonLd: {
    "@type": "SoftwareApplication",
    "@id": "https://danferg.com/chef#software",
    name: "Chef",
    description: "Conversational Agent Skills for household meal planning with transparent local Markdown memory.",
    url: "https://danferg.com/chef",
    codeRepository: sourceUrl,
    applicationCategory: "LifestyleApplication",
    operatingSystem: "Cross-platform",
    softwareVersion: "0.2.0",
    license: "https://opensource.org/license/mit",
    author: { "@id": "https://danferg.com/#person" },
  },
};

const skills = [
  ["01", "Plan, cook and remember", "Riff on the real week, choose meals naturally, get practical recipes and Bevel-friendly nutrition estimates, then keep explicit household context in readable Markdown."],
  ["02", "Prepare the shop", "Build a reconciled grocery list or, after a direct cart request, preserve the existing basket, add sensible quantities and verify the result before handing it back."],
];
---

<BaseLayout {...SEO}>
  <NavBar />
  <main id="main-content">
    <header class="site-container chef-hero" data-motion-intro-group>
      <div class="chef-hero__meta" data-motion-intro-item>
        <p>CHEF / AGENT SKILLS</p>
        <span>0.2.0</span>
      </div>
      <h1 data-motion-intro-item>Plan dinner naturally. <em>Keep the context you actually want.</em></h1>
      <p class="chef-hero__lede" data-motion-intro-item>
        Chef is a conversational meal-planning assistant that can remember explicit likes, dislikes,
        dietary needs and weekly plans in Markdown you can read and edit yourself.
      </p>
      <div class="chef-hero__actions" data-motion-intro-item>
        <a class="button button--primary" href={pluginDownloadUrl}>Download Chef plugin <span aria-hidden="true">↓</span></a>
        <a class="button" href={sourceUrl}>View source on GitHub <span aria-hidden="true">↗</span></a>
        <a class="button" href="/chef/install">Installation guide <span aria-hidden="true">→</span></a>
      </div>
      <p class="release-note" data-motion-intro-item>Stable release 0.2.0 is available from GitHub. The records-oriented 0.1 release remains archived, and the OpenAI directory listing is still separate.</p>
    </header>

    <section class="principle" aria-labelledby="principle-title">
      <div class="site-container principle__grid" data-motion-reveal>
        <div>
          <p class="eyebrow">01 // THE USEFUL BOUNDARY</p>
          <h2 id="principle-title">A conversation first. Plain files when memory matters.</h2>
        </div>
        <div>
          <p>On a local Codex host, Chef silently reads <code>~/Documents/Chef/MEMORY.md</code>, then keeps detailed weekly plans and the recipes you explicitly save in nearby Markdown files. There is no Chef account, runtime utility or database to operate.</p>
          <p>You can open those files, change the wording and add your own headings. Chef re-reads before editing and preserves manual changes. On hosts without local file access, the same conversation still works for the session, but Chef does not pretend it saved anything.</p>
        </div>
      </div>
    </section>

    <section class="site-container skills page-section" aria-labelledby="skills-title">
      <p class="eyebrow">02 // TWO FOCUSED SKILLS</p>
      <h2 id="skills-title">The whole meal-planning conversation, without the ceremony.</h2>
      <div class="skill-grid" data-motion-group>
        {skills.map(([number, title, description]) => (
          <article data-motion-item>
            <span>{number}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="shop" aria-labelledby="shop-title">
      <div class="site-container shop__grid" data-motion-reveal>
        <div>
          <p class="eyebrow">03 // OPTIONAL COMPUTER USE</p>
          <h2 id="shop-title">“Fill my cart” means fill it. Checkout still means stop.</h2>
        </div>
        <div>
          <p>Asking for a grocery list only produces a list. When you directly ask Chef to fill a cart, that request is enough authority to use an available browser or shopping capability—there is no approval token to repeat.</p>
          <p>Chef first inspects and preserves what is already there, resolves sensible quantities, then checks the basket itself. If something cannot be verified, it says so. Checkout, payment, fulfilment, restricted products and order placement remain human-controlled.</p>
          <a href="/chef/safety">Read the shopping and safety boundaries <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="site-container install page-section" aria-labelledby="install-title">
      <div>
        <p class="eyebrow">04 // GET CHEF</p>
        <h2 id="install-title">Download or install the stable release.</h2>
        <p>Download the OpenAI plugin, use the portable two-skill package, or clone the public repository. There is no Python runtime to install. Start a new Codex task after installation.</p>
      </div>
      <pre aria-label="Codex installation commands"><code>git clone https://github.com/DanielFerguson/chef-skills.git
cd chef-skills
codex plugin marketplace add .
codex plugin add chef@chef-skills</code></pre>
      <div class="install__links">
        <a href={pluginDownloadUrl}>Plugin ZIP ↓</a>
        <a href={skillsDownloadUrl}>Agent Skills ZIP ↓</a>
        <a href={checksumsUrl}>SHA-256 checksums ↓</a>
        <a href={releaseUrl}>Release notes ↗</a>
        <a href={archivedReleaseUrl}>Archived 0.1 release ↗</a>
        <a href="/chef/install">All installation options →</a>
        <a href="/chef/privacy">Privacy →</a>
        <a href="/chef/terms">Terms →</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .eyebrow,
  .chef-hero__meta {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.64rem;
    font-weight: 750;
    letter-spacing: 0.07em;
  }

  .chef-hero {
    padding-block: clamp(3.5rem, 8vw, 7rem);
  }

  .chef-hero__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px dotted var(--line-strong);
  }

  .chef-hero__meta p {
    margin: 0;
  }

  .chef-hero h1 {
    max-width: 15ch;
    margin: clamp(2rem, 5vw, 4rem) 0 0;
    font-size: clamp(2.7rem, 7vw, 6.4rem);
    line-height: 0.91;
    letter-spacing: -0.075em;
  }

  .chef-hero h1 em {
    color: var(--signal);
    font-style: normal;
  }

  .chef-hero__lede {
    max-width: 52rem;
    margin: 1.75rem 0 0;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.7vw, 1.15rem);
    line-height: 1.7;
  }

  .chef-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .button {
    display: inline-flex;
    min-width: 13rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--ink);
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 750;
    text-decoration: none;
  }

  .button--primary {
    color: var(--inverse-ink);
    border-color: var(--signal-fill);
    background: var(--signal-fill);
  }

  .button:is(:hover, :focus-visible) {
    color: var(--inverse-ink);
    background: var(--ink);
  }

  .button--primary:is(:hover, :focus-visible) {
    border-color: var(--signal-fill-hover);
    background: var(--signal-fill-hover);
  }

  .release-note {
    max-width: 46rem;
    margin: 1.25rem 0 0;
    color: var(--ink-muted);
    font-size: 0.7rem;
    line-height: 1.65;
  }

  .principle,
  .shop {
    border-block: 1px solid var(--line);
    background: var(--paper-raised);
  }

  .principle__grid,
  .shop__grid,
  .install {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(18rem, 1.1fr);
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  h2 {
    max-width: 18ch;
    margin: 1rem 0 0;
    font-size: clamp(1.8rem, 4vw, 3.3rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .principle__grid > div:last-child,
  .shop__grid > div:last-child,
  .install > div:first-child {
    color: var(--ink-soft);
    line-height: 1.8;
  }

  .principle__grid > div:last-child p:first-child,
  .shop__grid > div:last-child p:first-child {
    margin-top: 0;
  }

  .skills > h2 {
    margin-bottom: 2rem;
  }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
  }

  .skill-grid article {
    grid-column: span 3;
    min-height: 15rem;
    padding: 1.25rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .skill-grid span {
    color: var(--signal);
    font-size: 0.68rem;
    font-weight: 750;
  }

  .skill-grid h3 {
    margin: 3.5rem 0 0.75rem;
    font-size: 1.05rem;
  }

  .skill-grid p {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.7;
  }

  .shop a,
  .install__links a {
    color: var(--signal);
    font-weight: 700;
    text-underline-offset: 0.23em;
  }

  .install pre {
    overflow-x: auto;
    margin: 0;
    padding: 1.25rem;
    color: var(--code-ink);
    background: var(--code-surface);
    font-size: clamp(0.68rem, 1.3vw, 0.8rem);
    line-height: 1.8;
  }

  .install__links {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  @media (max-width: 760px) {
    .principle__grid,
    .shop__grid,
    .install {
      grid-template-columns: 1fr;
    }

    .install__links {
      grid-column: auto;
    }

    .skill-grid {
      grid-template-columns: 1fr;
    }

    .skill-grid article {
      grid-column: auto;
      min-height: 0;
    }

    .skill-grid h3 {
      margin-top: 2rem;
    }
  }
</style>
