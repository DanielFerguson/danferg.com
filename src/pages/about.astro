---
import type SEO from "types/SEO";
import BaseLayout from "@layouts/BaseLayout.astro";
import NavBar from "@components/NavBar.astro";
import SectionHeading from "@components/SectionHeading.astro";
import WorkHistory from "@components/WorkHistory.astro";
import ConversionEndcap from "@components/ConversionEndcap.astro";
import HeroPortrait from "@components/HeroPortrait.astro";
import portraitUrl from "../assets/images/dan-about-dark.png?url";
import { createContactMailto } from "../utils/contact-links";

const canonicalPath = "/about";
const contactMailto = createContactMailto({
  subject: "Hello from danferg.com",
  body: "G'day Dan,\n\n",
});

const now = [
  {
    meta: "Full-time · From Oct 2026",
    title: "Spatial Media",
    description:
      "Head of Innovation — running AI, product, and growth experiments across interactive 3D visualisation and digital engagement.",
    href: "https://www.spatialmedia.io/",
    external: true,
  },
  {
    meta: "Network & speaking",
    title: "Referrals & occasional talks",
    description:
      "Not taking on consulting while full-time at Spatial Media, though I’m always happy to refer teams to trusted people in my network.",
    href: "/consulting",
  },
  {
    meta: "Co-founder · 2022 – Present",
    title: "Ferguson Livestock",
    description:
      "Our family Murray Grey cattle stud and farm-direct beef business in Snake Valley, Victoria, along with the online store that runs it.",
    href: "/projects/ferguson-livestock",
  },
  {
    meta: "President · 2020 – Present",
    title: "Helping Group",
    description:
      "The charity founded during Black Summer, building practical digital services for communities before, during, and after disasters.",
    href: "/projects/helping-group",
  },
];

const SEO: SEO = {
  title: "About Dan Ferg — software builder in Melbourne",
  headline: "G’day, I’m Dan Ferg.",
  description:
    "Dan Ferg is a Melbourne-based software builder, Head of Innovation at Spatial Media, founder of Helping Group, and former CEO of Communiti Labs.",
  imageUrl: "/images/og-default.png",
  imageAlt: "About Dan Ferg",
  openGraph: { type: "profile" },
  canonicalUrl: canonicalPath,
  schemaType: "AboutPage",
  mainEntityId: "https://danferg.com/#person",
  modifiedDate: "2026-11-22",
  breadcrumbs: [
    { name: "Home", url: "/" },
    { name: "About", url: canonicalPath },
  ],
};
---

<BaseLayout {...SEO}>
  <NavBar />

  <main id="main-content">
    <header class="band page-hero-band">
      <div class="band__frame about-hero">
        <div data-motion-intro-group>
          <p class="page-hero__eyebrow" data-motion-intro-item>About</p>
          <h1 class="page-hero__title" data-motion-intro-item>
            G’day, I’m <em>Dan Ferg.</em>
          </h1>
          <p class="page-hero__lede" data-motion-intro-item>
            I’m Daniel Ferguson, a software builder in Melbourne. I’m full-time
            as Head of Innovation at Spatial Media, working across AI, product,
            and interactive 3D engagement tools.
          </p>
          <p class="page-hero__lede" data-motion-intro-item>
            Before that, I spent three years as CEO of Communiti Labs building
            feedback-analysis software for councils, and founded Helping Group
            after the 2020 bushfires. Outside work, I help run our family Murray
            Grey cattle stud and write about what building things actually looks
            like.
          </p>
        </div>

        <div
          class="about-hero__portrait"
          data-motion-intro
          data-motion-scale
          data-motion-delay="0.14"
        >
          <HeroPortrait
            src={portraitUrl}
            alt="Dan Ferg presenting a workshop on designing a business with no-code tools"
            width={1900}
            height={1425}
          />
        </div>
      </div>
    </header>

    <section class="band band--subtle" aria-labelledby="now-title">
      <div class="band__frame">
        <SectionHeading
          headingId="now-title"
          eyebrow="Now"
          title="What I’m focused on."
          description="My full-time role at Spatial Media, plus the ventures and community projects I still run."
        />
        <ul class="now-grid" role="list" data-motion-group>
          {
            now.map((item) => (
              <li data-motion-item>
                <a
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                  data-astro-prefetch={item.external ? undefined : "hover"}
                  data-motion-interactive
                >
                  <small>{item.meta}</small>
                  <strong>
                    {item.title}
                    {item.external && (
                      <span class="visually-hidden"> (opens in a new tab)</span>
                    )}
                    <i aria-hidden="true" data-motion-arrow>
                      {item.external ? "↗" : "→"}
                    </i>
                  </strong>
                  <span>{item.description}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="work" class="band" aria-labelledby="career-title">
      <div class="band__frame">
        <SectionHeading
          headingId="career-title"
          eyebrow="Experience"
          title="Where I’ve worked."
          description="Startups, public-interest software, consulting, and a family cattle stud."
          actionHref="https://www.linkedin.com/in/danferg"
          actionLabel="LinkedIn profile"
        />
        <WorkHistory />
      </div>
    </section>

    <ConversionEndcap
      headingId="about-contact"
      eyebrow="Say g'day"
      title="Want to chat or need a referral?"
      description="I’m full-time at Spatial Media so my consulting calendar is closed, but I’m always glad to hear from people building interesting things — or connect you with trusted peers in my network."
      actions={[
        {
          meta: "Email",
          label: "gday@danferg.com",
          href: contactMailto,
        },
        {
          meta: "Availability",
          label: "Consulting & referrals",
          href: "/consulting",
        },
        {
          meta: "Projects",
          label: "Explore my work",
          href: "/projects",
        },
      ]}
    />
  </main>
</BaseLayout>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.24fr) minmax(18rem, 0.76fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-block: clamp(3rem, 6vw, 5.25rem);
  }

  .now-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .now-grid li {
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .now-grid a {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 0.55rem;
    padding: clamp(1.35rem, 3vw, 2rem);
    color: inherit;
    background: var(--paper);
    text-decoration: none;
    transition: background-color 140ms ease;
  }

  .now-grid a:is(:hover, :focus-visible) {
    background: var(--paper-subtle);
  }

  .now-grid a:is(:hover, :focus-visible) strong {
    color: var(--signal);
  }

  .now-grid small {
    color: var(--ink-muted);
    font-size: 0.8125rem;
  }

  .now-grid strong {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    color: var(--ink);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    transition: color 140ms ease;
  }

  .now-grid strong i {
    color: var(--signal);
    font-style: normal;
  }

  .now-grid a > span {
    color: var(--ink-soft);
    font-size: 0.925rem;
    line-height: 1.6;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .about-hero {
      grid-template-columns: 1fr;
    }

    .about-hero__portrait {
      max-width: 28rem;
    }
  }

  @media (max-width: 760px) {
    .now-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
