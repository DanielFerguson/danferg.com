---
import type SEO from "types/SEO";
import { Image } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import NavBar from "@components/NavBar.astro";
import SectionHeading from "@components/SectionHeading.astro";
import WorkHistory from "@components/WorkHistory.astro";
import ConversionEndcap from "@components/ConversionEndcap.astro";
import portrait from "../assets/images/danferg.webp";
import { createContactMailto } from "../utils/contact-links";

const canonicalPath = "/about";
const contactMailto = createContactMailto({
  subject: "Hello from danferg.com",
  body: "G'day Dan,\n\n",
});

const shortBio =
  "Dan Ferg is a Melbourne-based product consultant, advisor and software builder. He founded Helping Group, a digital-first charity, after the 2020 bushfires and was chief executive of civic technology company Communiti Labs from 2023 to 2026. Earlier, he was chief technology officer at Imperial Wealth and a full-stack developer at CeRDI. In 2026 he co-hosted season six of the For the Love of Community Engagement podcast.";

const now = [
  {
    meta: "CONSULTING / ADVISORY",
    title: "Product, traction and go-to-market work",
    description:
      "Helping founders and mission-led teams make difficult product, software and go-to-market decisions, then act on them.",
    href: "/consulting",
  },
  {
    meta: "FOUNDER / 2026 — NOW",
    title: "WP Flame",
    description:
      "A self-hosted performance flight recorder for dynamic WordPress sites, working with design partners before release.",
    href: "/projects/wp-flame",
  },
  {
    meta: "CO-FOUNDER / 2022 — NOW",
    title: "Ferguson Livestock",
    description:
      "A Murray Grey cattle stud and farm-direct beef venture in Snake Valley, with the software that helps run it.",
    href: "/projects/ferguson-livestock",
  },
  {
    meta: "PRESIDENT / 2020 — NOW",
    title: "Helping Group",
    description:
      "The social-impact organisation that began during Black Summer, building practical services for communities before, during and after disasters.",
    href: "/projects/helping-group",
  },
];

const SEO: SEO = {
  title: "About Dan Ferg, product consultant and builder | Dan Ferg",
  headline: "About Dan Ferg",
  description:
    "Dan Ferg is a Melbourne-based product consultant, advisor and software builder: founder of Helping Group and former CEO of Communiti Labs.",
  imageUrl: "/images/og-default.png",
  imageAlt: "About Dan Ferg",
  openGraph: { type: "profile" },
  canonicalUrl: canonicalPath,
  schemaType: "AboutPage",
  mainEntityId: "https://danferg.com/#person",
  modifiedDate: "2026-09-27",
  breadcrumbs: [
    { name: "Home", url: "/" },
    { name: "About", url: canonicalPath },
  ],
};
---

<BaseLayout {...SEO}>
  <NavBar />
  <main id="main-content">
    <header class="site-container about-hero" data-motion-intro-group>
      <div>
        <p class="eyebrow" data-motion-intro-item>// ABOUT</p>
        <h1 data-motion-intro-item>About <em>Dan Ferg.</em></h1>
        <p class="about-hero__lede" data-motion-intro-item>
          I’m Dan Ferg (Daniel Ferguson), a Melbourne-based product consultant,
          advisor and software builder. I help founders and mission-led teams
          turn hard product, operational and community problems into useful
          software, traction and a clearer route to market.
        </p>
        <p class="about-hero__lede" data-motion-intro-item>
          I founded Helping Group after the 2020 bushfires and spent three years
          as CEO of Communiti Labs, building tools that helped councils and
          practitioners turn community feedback into evidence. I write about
          what those ventures taught me, including the parts that didn’t work.
        </p>
      </div>
      <figure class="about-hero__portrait" data-motion-intro-item>
        <Image
          src={portrait}
          alt="Dan Ferg presenting a workshop on designing a business with no-code tools, with the slides on two screens behind him"
          widths={[480, 800, 1200]}
          sizes="(min-width: 900px) 28rem, calc(100vw - 2.5rem)"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </header>

    <section class="site-container page-section" aria-labelledby="now-title">
      <SectionHeading
        headingId="now-title"
        eyebrow="01 // WHAT I’M WORKING ON"
        title="Now."
        description="Consulting sits alongside the ventures I still run."
      />
      <ul class="now-grid" role="list" data-motion-group>
        {now.map((item) => (
          <li data-motion-item>
            <a href={item.href} data-motion-interactive>
              <small>{item.meta}</small>
              <strong>{item.title}</strong>
              <span>{item.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="work" class="site-container page-section" aria-labelledby="career-title">
      <SectionHeading
        headingId="career-title"
        eyebrow="02 // CAREER"
        title="Where I’ve worked."
        description="Roles across civic technology, social impact, financial services and research, most recent first."
      />
      <WorkHistory />
    </section>

    <section class="site-container page-section bio" aria-labelledby="bio-title">
      <SectionHeading
        headingId="bio-title"
        eyebrow="03 // FOR ORGANISERS AND EDITORS"
        title="Short bio."
        description="Free to use for event listings, podcasts and articles."
      />
      <blockquote class="bio__text" data-motion-reveal>
        <p>{shortBio}</p>
      </blockquote>
      <p class="bio__links">
        <a href="/speaking">Talks and podcasts <span aria-hidden="true">→</span></a>
        <a href="https://www.linkedin.com/in/danferg" target="_blank" rel="noopener noreferrer me">LinkedIn <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/danielferguson" target="_blank" rel="noopener noreferrer me">GitHub <span aria-hidden="true">↗</span></a>
      </p>
    </section>

    <ConversionEndcap
      headingId="about-contact"
      eyebrow="// SAY G'DAY"
      title="Working on something hard and worthwhile?"
      description="I’m happy to hear about product problems, speaking invitations, or projects that could use another builder."
      actions={[
        {
          meta: "CONSULTING / ADVISORY",
          label: "How I can help",
          href: "/consulting",
        },
        {
          meta: "EMAIL",
          label: "gday@danferg.com",
          href: contactMailto,
        },
        {
          meta: "SELECTED WORK",
          label: "Explore the project archive",
          href: "/projects",
        },
      ]}
    />
  </main>
</BaseLayout>

<style>
  .eyebrow {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.07em;
  }

  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  h1 {
    margin: 1rem 0 0;
    font-size: clamp(2.5rem, 6vw, 5.35rem);
    line-height: 0.94;
    letter-spacing: -0.072em;
  }

  h1 em {
    color: var(--signal);
    font-style: normal;
  }

  .about-hero__lede {
    max-width: 42rem;
    margin: 1.4rem 0 0;
    color: var(--ink-soft);
    font-size: clamp(0.88rem, 1.6vw, 1rem);
    line-height: 1.7;
  }

  .about-hero__portrait {
    margin: 0;
  }

  .about-hero__portrait img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line-strong);
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .now-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
    border-left: 1px solid var(--line-strong);
  }

  .now-grid li {
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .now-grid a {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    height: 100%;
    padding: clamp(1.1rem, 3vw, 1.6rem);
    color: inherit;
    text-decoration: none;
  }

  .now-grid a:is(:hover, :focus-visible) {
    background: var(--signal-soft);
  }

  .now-grid small {
    color: var(--signal);
    font-size: var(--text-label);
    font-weight: 750;
    letter-spacing: 0.06em;
  }

  .now-grid strong {
    color: var(--ink);
    font-size: 1.05rem;
    letter-spacing: -0.03em;
  }

  .now-grid span {
    color: var(--ink-soft);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .bio__text {
    max-width: 48rem;
    margin: 0;
    padding: clamp(1.1rem, 3vw, 1.6rem);
    border-left: 3px solid var(--signal);
    background: var(--paper-raised);
  }

  .bio__text p {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: clamp(0.98rem, 1.4vw, 1.05rem);
    line-height: 1.7;
  }

  .bio__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 1.25rem 0 0;
  }

  .bio__links a {
    color: var(--signal);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 820px) {
    .about-hero,
    .now-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
