---
import type SEO from "types/SEO";
import BaseLayout from "@layouts/BaseLayout.astro";
import NavBar from "@components/NavBar.astro";
import SectionHeading from "@components/SectionHeading.astro";
import ContentList from "@components/ContentList.astro";
import ConversionEndcap from "@components/ConversionEndcap.astro";
import SpotifyEpisodePlayer from "@components/SpotifyEpisodePlayer.astro";
import { podcastAppearances, selectedTalks } from "../data/speaking";
import { createContactMailto } from "../utils/contact-links";

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("en-AU", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  }).format(new Date(`${date}T00:00:00`));

const talkItems = selectedTalks.map((talk) => ({
  title: talk.title,
  description: talk.description,
  href: talk.href,
  meta: formatDate(talk.date),
  detail: talk.topic,
  external: true,
}));

const topics = [
  {
    title: "Closing the loop in community engagement",
    description:
      "Why participation needs visible follow-through, not just better surveys.",
    href: "/articles/democracy-doesnt-need-another-survey",
  },
  {
    title: "Practical AI in local government and education",
    description:
      "Using AI to back up human judgement and learning instead of replacing it.",
    href: "/articles/ai-belongs-in-the-learning-loop",
  },
  {
    title: "From rough idea to working product",
    description:
      "Testing a concept quickly before committing to a long build.",
    href: "/newsletters/2022-05-09-concept-to-production",
  },
  {
    title: "When startups don’t go to plan",
    description:
      "Winding down a company, recovering from burnout, and deciding what comes next.",
    href: "/projects/communitilabs",
  },
];

const speakingMailto = createContactMailto({
  subject: "Speaking or podcast enquiry",
  body: "G'day Dan,\n\nI'd like to invite you to speak or join a podcast.\n\nAudience, topic, format, and timing:\n",
});

const canonicalPath = "/speaking";
const SEO: SEO = {
  title: "Speaking, podcasts and talks | Dan Ferg",
  headline: "Talks and conversations.",
  description:
    "Watch and listen to Dan Ferg on community engagement, practical AI, building products, and startup lessons.",
  imageUrl: "/images/og-default.png",
  imageAlt: "Dan Ferg — speaking, podcasts and talks",
  openGraph: { type: "website" },
  canonicalUrl: canonicalPath,
  schemaType: "CollectionPage",
  modifiedDate: "2026-11-22",
  breadcrumbs: [
    { name: "Home", url: "/" },
    { name: "Speaking", url: canonicalPath },
  ],
  jsonLd: {
    "@type": "ItemList",
    "@id": "https://danferg.com/speaking#podcasts",
    name: "Dan Ferg podcast appearances",
    numberOfItems: podcastAppearances.length,
    itemListElement: podcastAppearances.map((episode, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "PodcastEpisode",
        name: episode.title,
        datePublished: episode.date,
        url: episode.spotifyUrl,
        partOfSeries: {
          "@type": "PodcastSeries",
          name: episode.show,
        },
      },
    })),
  },
};
---

<BaseLayout {...SEO}>
  <NavBar />

  <main id="main-content">
    <header class="band page-hero-band">
      <div class="band__frame page-hero" data-motion-intro-group>
        <p class="page-hero__eyebrow" data-motion-intro-item>
          Speaking &amp; podcasts
        </p>
        <h1 class="page-hero__title" data-motion-intro-item>
          Talks and <em>conversations.</em>
        </h1>
        <p class="page-hero__lede" data-motion-intro-item>
          Podcast episodes, workshops, and talks on community engagement,
          practical AI, building products, and what happens when tidy plans meet
          real life.
        </p>
        <div class="page-hero__actions" data-motion-intro-item>
          <a class="btn btn--primary" href="#podcasts" data-motion-interactive>
            Watch the latest
            <span aria-hidden="true" data-motion-arrow data-motion-axis="y">
              ↓
            </span>
          </a>
          <a
            class="btn btn--secondary"
            href={speakingMailto}
            data-motion-interactive
          >
            Invite me to speak
            <span aria-hidden="true" data-motion-arrow>↗</span>
          </a>
        </div>
      </div>
    </header>

    <section
      id="podcasts"
      class="band band--subtle"
      aria-labelledby="podcasts-title"
    >
      <div class="band__frame">
        <SectionHeading
          headingId="podcasts-title"
          eyebrow="For the Love of Community Engagement"
          title="Season six conversations."
          description="I joined Becky Hirst as co-host for season six — candid conversations with practitioners about the next decade of community engagement."
        />
        <SpotifyEpisodePlayer episodes={podcastAppearances} />
      </div>
    </section>

    <section class="band" aria-labelledby="topics-title">
      <div class="band__frame">
        <SectionHeading
          headingId="topics-title"
          eyebrow="Topics"
          title="What I talk about."
          description="Panels, workshops, and podcast episodes around my day job. Each topic links to deeper writing or work."
        />
        <ul class="topics" role="list" data-motion-group>
          {
            topics.map((topic) => (
              <li data-motion-item>
                <a href={topic.href} data-motion-interactive>
                  <strong>{topic.title}</strong>
                  <span>{topic.description}</span>
                  <span class="topics__cta" aria-hidden="true">
                    Read more <span data-motion-arrow>→</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section
      class="band band--subtle"
      aria-labelledby="talks-archive-title"
    >
      <div class="band__frame">
        <SectionHeading
          headingId="talks-archive-title"
          eyebrow="Earlier talks"
          title="Past workshops and sessions."
          description="Earlier talks on going from a rough concept to a working product and leading teams."
        />
        <ContentList
          items={talkItems}
          orderedLabel="Selected talks and workshops"
        />
      </div>
    </section>

    <ConversionEndcap
      headingId="speaking-contact"
      eyebrow="Speaking & podcasts"
      title="Have a podcast, panel, or workshop in mind?"
      description="I’m full-time at Spatial Media so my time is tight, though I still fit in the occasional podcast or talk. Send the audience, topic, and timing — if I can’t make it, I’ll happily suggest someone great."
      actions={[
        {
          meta: "Email",
          label: "Invite me to speak",
          href: speakingMailto,
          description: "Share the audience, format, topic, and timing.",
        },
        {
          meta: "Availability",
          label: "Consulting & referrals",
          href: "/consulting",
          description: "Current availability and referrals to my network.",
        },
      ]}
    />
  </main>
</BaseLayout>

<style>
  .topics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .topics li {
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .topics a {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 0.55rem;
    padding: clamp(1.35rem, 3vw, 2rem);
    color: inherit;
    background: var(--paper);
    text-decoration: none;
    transition: background-color 140ms ease;
  }

  .topics a:is(:hover, :focus-visible) {
    background: var(--paper-subtle);
  }

  .topics a:is(:hover, :focus-visible) strong,
  .topics a:is(:hover, :focus-visible) .topics__cta {
    color: var(--signal);
  }

  .topics strong {
    color: var(--ink);
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    transition: color 140ms ease;
  }

  .topics a > span {
    color: var(--ink-soft);
    font-size: 0.925rem;
    line-height: 1.6;
  }

  .topics__cta {
    margin-top: auto;
    padding-top: 0.45rem;
    color: var(--ink-muted);
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 140ms ease;
  }

  @media (max-width: 720px) {
    .topics {
      grid-template-columns: 1fr;
    }
  }
</style>
