---
import type SEO from "types/SEO";
import { getCollection } from "astro:content";
import getReadingTime from "reading-time";

import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import ContentList from "../components/ContentList.astro";
import HeroSignalField from "../components/HeroSignalField.astro";
import WorkHistory from "../components/WorkHistory.astro";
import ImpactStats from "../components/ImpactStats.astro";
import { compareProjectsByPeriod } from "../utils/project-sort";
import { editorialUpdates } from "../data/editorial-updates";
import { podcastAppearances, selectedTalks } from "../data/speaking";

const SEO: SEO = {
  title: "Dan Ferg — Software builder in Melbourne",
  headline: "I build practical software for real-world problems.",
  description:
    "Dan Ferg is a Melbourne-based software builder and Head of Innovation at Spatial Media, building tools across civic tech, AI, and agriculture.",
  imageUrl: "/images/og-default.png",
  openGraph: { type: "website" },
  canonicalUrl: "/",
};

const projects = (await getCollection("projects"))
  .map((project) => ({
    url: project.data.canonicalUrl,
    frontmatter: project.data,
  }))
  .filter(
    (project) =>
      project.frontmatter.visible !== false &&
      project.frontmatter.featured !== false,
  )
  .sort(compareProjectsByPeriod);

const articles = (await getCollection("articles")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("en-AU", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  }).format(new Date(`${date}T00:00:00`));

const articleItems = [
  ...articles.map((article) => ({
    title: article.data.title,
    description: article.data.description,
    href: article.data.canonicalUrl,
    date: article.data.date,
    meta: formatDate(article.data.date),
    detail: getReadingTime(article.body || "").text,
  })),
  ...editorialUpdates.map((update) => ({
    title: update.title,
    description: update.description,
    href: update.canonicalUrl,
    date: update.date,
    meta: formatDate(update.date),
    detail: update.category,
  })),
]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 6)
  .map(({ date: _date, ...item }) => item);

const speakingItems = [
  ...podcastAppearances.map((episode) => ({
    title: episode.title,
    description: episode.description,
    href: `/speaking#episode-${episode.spotifyId}`,
    date: episode.date,
    meta: formatDate(episode.date),
    detail: "Podcast",
    external: false,
  })),
  ...selectedTalks.map((talk) => ({
    title: talk.title,
    description: talk.description,
    href: talk.href,
    date: talk.date,
    meta: formatDate(talk.date),
    detail: talk.topic,
    external: true,
  })),
]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 5)
  .map(({ date: _date, ...item }) => item);
---

<BaseLayout {...SEO}>
  <NavBar />

  <main id="main-content">
    <section
      class="hero-band band"
      aria-labelledby="hero-title"
      data-hero-signal-host
    >
      <div class="band__frame hero">
        <HeroSignalField />

        <div class="hero__copy" data-motion-intro-group>
          <p class="hero__eyebrow" data-motion-intro-item>
            <span class="hero__eyebrow-dot" aria-hidden="true"></span>
            Melbourne, Australia
          </p>
          <h1 id="hero-title" data-motion-intro-item>
            I build <em>practical software</em> for <span class="nowrap">real-world</span> problems.
          </h1>
          <p class="hero__lede" data-motion-intro-item>
            I’m Dan Ferg, a software builder in Melbourne. I’m full-time as Head
            of Innovation at Spatial Media, and build side projects across civic
            tech, AI, and agriculture.
          </p>
          <div class="hero__actions" data-motion-intro-item>
            <a class="btn btn--primary" href="#projects" data-motion-interactive>
              See my work
              <span aria-hidden="true" data-motion-arrow data-motion-axis="y">
                ↓
              </span>
            </a>
            <a
              class="btn btn--secondary"
              href="/consulting"
              data-motion-interactive
            >
              Get in touch
              <span aria-hidden="true" data-motion-arrow>→</span>
            </a>
          </div>
          <p class="hero__note" data-motion-intro-item>
            Now full-time at Spatial Media with very limited consulting
            availability — always glad to refer you to trusted people in my
            network.
          </p>
        </div>
      </div>
    </section>

    <ImpactStats />

    <section
      id="projects"
      class="band band--subtle"
      aria-labelledby="projects-title"
    >
      <div class="band__frame">
        <SectionHeading
          headingId="projects-title"
          eyebrow="Selected work"
          title="Things I’ve built."
          description="Products, client platforms, and side projects — what worked, and what didn’t."
          actionHref="/projects"
          actionLabel="All projects"
        />
        <ProjectGrid projects={projects} />
      </div>
    </section>

    <section id="articles" class="band" aria-labelledby="articles-title">
      <div class="band__frame">
        <SectionHeading
          headingId="articles-title"
          eyebrow="Writing"
          title="Recent articles."
          description="Honest notes on software, startups, AI, and the lessons that show up after launch."
          actionHref="/articles"
          actionLabel="All articles"
        />
        <ContentList items={articleItems} orderedLabel="Latest articles" />
      </div>
    </section>

    <section id="work" class="band band--subtle" aria-labelledby="work-title">
      <div class="band__frame">
        <SectionHeading
          headingId="work-title"
          eyebrow="Experience"
          title="Where I’ve worked."
          description="Startups, public-interest software, consulting, and a family cattle stud."
          actionHref="https://www.linkedin.com/in/danferg"
          actionLabel="LinkedIn profile"
        />
        <WorkHistory />
      </div>
    </section>

    <section
      id="talks"
      class="band band--dark talks"
      aria-labelledby="talks-title"
    >
      <div class="band__frame">
        <SectionHeading
          headingId="talks-title"
          eyebrow="Speaking & podcasts"
          title="Talks and conversations."
          description="Podcast episodes and workshops on AI at work, community engagement, and building products."
          actionHref="/speaking"
          actionLabel="All talks & podcasts"
        />
        <ContentList
          items={speakingItems}
          orderedLabel="Recent podcast appearances and talks"
        />
      </div>
    </section>

    <section
      class="cta-section band"
      aria-labelledby="contact-title"
      data-motion-reveal
    >
      <div class="band__frame cta-section__frame">
        <div class="cta-card">
          <div class="cta-card__copy">
            <p class="cta-card__eyebrow">Get in touch</p>
            <h2 id="contact-title">Looking for a hand on something tricky?</h2>
            <p class="cta-card__lede">
              I’m full-time at Spatial Media now, so my consulting availability
              is very limited. Still, send a note — if I can’t help directly,
              I’m glad to refer you to fellow professionals in my network.
            </p>
          </div>
          <div class="cta-card__actions">
            <a
              class="btn btn--white"
              href="mailto:gday@danferg.com?subject=Quick%20note%20from%20danferg.com"
              data-motion-interactive
            >
              Email gday@danferg.com
              <span aria-hidden="true" data-motion-arrow>→</span>
            </a>
            <a class="cta-card__link" href="/consulting">
              Availability &amp; referrals →
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero-band {
    background: var(--paper);
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    min-height: clamp(28rem, 42vw, 35rem);
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .hero__copy {
    position: relative;
    z-index: 1;
  }

  .hero__eyebrow {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    margin: 0 0 1.25rem;
    color: var(--ink-soft);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .hero__eyebrow-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--signal), var(--signal-pink));
  }

  h1 {
    max-width: 17ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.45rem, 5vw, 4.1rem);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.035em;
  }

  h1 em {
    color: var(--signal);
    background: linear-gradient(
      95deg,
      var(--signal) 0%,
      #7c4dff 55%,
      var(--signal-pink) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-style: normal;
  }

  .nowrap {
    white-space: nowrap;
  }

  .hero__lede {
    max-width: 34rem;
    margin: 1.35rem 0 0;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.35vw, 1.08rem);
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.85rem;
  }

  .hero__note {
    margin: 1.15rem 0 0;
    color: var(--ink-muted);
    font-size: 0.84rem;
  }

  /* Deep aubergine-charcoal speaking band with Communiti pink accents. */
  .talks :global(.section-heading__eyebrow) {
    color: var(--signal-bright);
  }

  .talks :global(.section-heading__title) {
    color: var(--inverse-ink);
  }

  .talks :global(.section-heading__aside p),
  .talks :global(.content-list__desc),
  .talks :global(.content-list__meta),
  .talks :global(.content-list__detail),
  .talks :global(.content-list__arrow) {
    color: var(--inverse-muted);
  }

  .talks :global(.section-heading__aside a) {
    color: var(--signal-bright);
  }

  .talks :global(.content-list),
  .talks :global(.content-list li) {
    border-color: rgb(228 154 255 / 14%);
  }

  .talks :global(.content-list a) {
    color: var(--inverse-ink);
  }

  .talks :global(.content-list a:is(:hover, :focus-visible) strong),
  .talks :global(.content-list a:is(:hover, :focus-visible) .content-list__arrow) {
    color: var(--signal-bright);
  }

  /* Contained Communiti purple & pink closing panel. */
  .cta-section__frame {
    padding-block: clamp(2.75rem, 5vw, 4.25rem);
  }

  .cta-card {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) auto;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: center;
    padding: clamp(2rem, 4.5vw, 3.5rem);
    border: 1px solid rgb(204 102 255 / 28%);
    border-radius: var(--radius-md);
    color: var(--inverse-ink);
    background:
      radial-gradient(
        circle at 92% 14%,
        rgb(204 102 255 / 34%) 0%,
        transparent 46%
      ),
      radial-gradient(
        circle at 10% 95%,
        rgb(79 57 246 / 52%) 0%,
        transparent 52%
      ),
      var(--signal-indigo);
  }

  .cta-card__eyebrow {
    margin: 0 0 0.65rem;
    color: var(--signal-bright);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .cta-card h2 {
    max-width: 16ch;
    margin: 0;
    color: var(--inverse-ink);
    font-size: clamp(1.85rem, 3.6vw, 2.85rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .cta-card__lede {
    max-width: 36rem;
    margin: 0.9rem 0 0;
    color: rgb(250 249 255 / 84%);
    font-size: 0.975rem;
    line-height: 1.65;
  }

  .cta-card__actions {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    align-items: flex-end;
  }

  .cta-card__link {
    color: var(--signal-bright);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }

  .cta-card__link:is(:hover, :focus-visible) {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-bottom: clamp(10rem, 32vw, 14rem);
    }

    .cta-card {
      grid-template-columns: 1fr;
    }

    .cta-card__actions {
      align-items: flex-start;
    }
  }

  @media (max-width: 620px) {
    .hero__actions {
      flex-direction: column;
    }

    .btn {
      width: 100%;
    }
  }
</style>
