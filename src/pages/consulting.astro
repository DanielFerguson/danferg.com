---
import type SEO from "types/SEO";
import BaseLayout from "@layouts/BaseLayout.astro";
import NavBar from "@components/NavBar.astro";
import SectionHeading from "@components/SectionHeading.astro";
import ConversionEndcap from "@components/ConversionEndcap.astro";
import { createContactMailto } from "../utils/contact-links";

const canonicalPath = "/consulting";
const contactMailto = createContactMailto({
  subject: "Referral or quick question via danferg.com",
  body: "G'day Dan,\n\nI know you're full-time at Spatial Media at the moment, so I'm reaching out for a referral or quick steer.\n\nHere's what we're working on:\n",
});

const faqs = [
  {
    question: "Are you currently available for consulting?",
    answer:
      "No — I’m full-time as Head of Innovation at Spatial Media, so my availability for outside work is very limited right now.",
  },
  {
    question: "Can you still help point us in the right direction?",
    answer:
      "Gladly. Send a short note about what you’re trying to solve and I’ll do my best to connect you with trusted product leaders, engineers, or strategists in my network.",
  },
  {
    question: "Do you still take on speaking or podcast invitations?",
    answer:
      "Occasionally, when timing works around my day job. Feel free to send the topic, audience, and dates.",
  },
  {
    question: "What should I include in a note?",
    answer:
      "A couple of paragraphs on the problem, the kind of help you’re looking for, and your rough timeline. I’ll reply honestly with whether I know the right person to introduce you to.",
  },
];

const SEO: SEO = {
  title: "Consulting availability and referrals | Dan Ferg",
  headline: "Not currently taking on consulting.",
  description:
    "Dan Ferg is full-time at Spatial Media with very limited consulting availability, and is happy to refer teams to trusted professionals in his network.",
  imageUrl: "/images/og-default.png",
  imageAlt: "Dan Ferg — consulting availability and referrals",
  openGraph: { type: "website" },
  canonicalUrl: canonicalPath,
  schemaType: "WebPage",
  mainEntityId: "https://danferg.com/consulting#faq",
  modifiedDate: "2026-11-22",
  breadcrumbs: [
    { name: "Home", url: "/" },
    { name: "Consulting", url: canonicalPath },
  ],
  jsonLd: [
    {
      "@type": "FAQPage",
      "@id": "https://danferg.com/consulting#faq",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    },
  ],
};

const waysToHelp = [
  {
    title: "Referrals to trusted peers",
    description:
      "I know good product thinkers, engineers, designers, and engagement specialists across Australia. Tell me what you need and I’ll introduce you if someone fits.",
  },
  {
    title: "Occasional speaking & podcasts",
    description:
      "I still fit in the odd panel, podcast, or practical workshop on AI at work, community engagement, and building products.",
  },
  {
    title: "Rare, small advisory chats",
    description:
      "My day job comes first, so I’m not taking on retainers or builds — though I’m always happy to trade notes with founders working on worthwhile problems.",
  },
];

const proof = [
  {
    meta: "Civic technology",
    title: "Communiti Labs",
    description:
      "Three years building community-feedback analysis tools for councils — and the honest story of winding it down.",
    href: "/projects/communitilabs",
  },
  {
    meta: "Client platform",
    title: "Murray Grey Association Australia",
    description:
      "A custom website and searchable herd book replacing fragile legacy infrastructure.",
    href: "/projects/murray-grey-association-australia",
  },
  {
    meta: "Crisis response",
    title: "Helping Group",
    description:
      "Started during the 2020 bushfires and grew into practical digital infrastructure for communities in emergencies.",
    href: "/projects/helping-group",
  },
];
---

<BaseLayout {...SEO}>
  <NavBar />

  <main id="main-content">
    <header class="band page-hero-band">
      <div class="band__frame page-hero" data-motion-intro-group>
        <p class="page-hero__eyebrow" data-motion-intro-item>
          Availability &amp; referrals
        </p>
        <h1 class="page-hero__title" data-motion-intro-item>
          Not currently taking on <em>consulting.</em>
        </h1>
        <p class="page-hero__lede" data-motion-intro-item>
          I’m full-time as Head of Innovation at Spatial Media, so my
          availability for outside work is very limited. If you need help with
          product, software, or AI, send a note anyway — I’m happy to connect
          you with trusted people in my network.
        </p>
        <div class="page-hero__actions" data-motion-intro-item>
          <a
            class="btn btn--primary"
            href={contactMailto}
            data-motion-interactive
          >
            Ask for a referral
            <span aria-hidden="true" data-motion-arrow>↗</span>
          </a>
          <a class="btn btn--secondary" href="#proof" data-motion-interactive>
            See past work
            <span aria-hidden="true" data-motion-arrow data-motion-axis="y">
              ↓
            </span>
          </a>
        </div>
      </div>
    </header>

    <section class="band band--subtle" aria-labelledby="help-title">
      <div class="band__frame">
        <SectionHeading
          headingId="help-title"
          eyebrow="How I can still help"
          title="Happy to point you to good people."
          description="Even when my calendar is full, a warm introduction to the right specialist usually saves weeks."
        />
        <div class="help-grid" data-motion-group>
          {
            waysToHelp.map((item) => (
              <article class="help-card" data-motion-item>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="proof" class="band" aria-labelledby="proof-title">
      <div class="band__frame">
        <SectionHeading
          headingId="proof-title"
          eyebrow="Past work"
          title="A few things I’ve shipped."
          description="Context on the kinds of problems and teams I know well."
          actionHref="/projects"
          actionLabel="All projects"
        />
        <div class="proof-grid" data-motion-group>
          {
            proof.map((item) => (
              <a
                href={item.href}
                data-motion-item
                data-motion-interactive
                data-astro-prefetch="hover"
              >
                <small>{item.meta}</small>
                <strong>{item.title}</strong>
                <span>{item.description}</span>
                <span class="proof-grid__cta" aria-hidden="true">
                  Read story <span data-motion-arrow>→</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="band band--subtle faq" aria-labelledby="faq-title">
      <div class="band__frame">
        <SectionHeading
          headingId="faq-title"
          eyebrow="Questions"
          title="Quick answers."
        />
        <div class="faq__list" data-motion-reveal>
          {
            faqs.map((faq) => (
              <details>
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <ConversionEndcap
      headingId="consulting-contact"
      eyebrow="Referrals"
      title="Looking for someone you can trust?"
      description="Send a short note with what you’re working on and the kind of help you need. If someone in my network is a great fit, I’ll happily make the introduction."
      actions={[
        {
          meta: "Email",
          label: "gday@danferg.com",
          href: contactMailto,
          description: "A couple of sentences on the problem and timing is plenty.",
        },
        {
          meta: "Projects",
          label: "Browse past work",
          href: "/projects",
          description: "See the products and platforms I’ve built.",
        },
      ]}
    />
  </main>
</BaseLayout>

<style>
  .help-grid,
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .help-card {
    padding: clamp(1.35rem, 3vw, 2rem);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .help-card h3 {
    margin: 0;
    color: var(--ink);
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .help-card p {
    margin: 0.65rem 0 0;
    color: var(--ink-soft);
    font-size: 0.925rem;
    line-height: 1.6;
  }

  .proof-grid a {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1.35rem, 3vw, 2rem);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    background: var(--paper);
    text-decoration: none;
    transition: background-color 140ms ease;
  }

  .proof-grid a:is(:hover, :focus-visible) {
    background: var(--paper-subtle);
  }

  .proof-grid a:is(:hover, :focus-visible) strong,
  .proof-grid a:is(:hover, :focus-visible) .proof-grid__cta {
    color: var(--signal);
  }

  .proof-grid small {
    color: var(--ink-muted);
    font-size: 0.8125rem;
  }

  .proof-grid strong {
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
    transition: color 140ms ease;
  }

  .proof-grid a > span {
    color: var(--ink-soft);
    font-size: 0.925rem;
    line-height: 1.6;
  }

  .proof-grid__cta {
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--ink-muted);
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 140ms ease;
  }

  .faq__list {
    max-width: 52rem;
    border-top: 1px solid var(--line);
  }

  .faq details {
    border-bottom: 1px solid var(--line);
    interpolate-size: allow-keywords;
  }

  .faq summary {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding: 1.15rem 0;
    color: var(--ink);
    font-size: 1.02rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::after {
    flex-shrink: 0;
    color: var(--signal);
    content: "+";
  }

  .faq details[open] summary::after {
    content: "−";
  }

  .faq summary:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 4px;
  }

  .faq details p {
    max-width: 44rem;
    margin: 0 0 1.25rem;
    color: var(--ink-soft);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq details::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 220ms ease,
        content-visibility 220ms allow-discrete;
    }

    .faq details[open]::details-content {
      block-size: auto;
    }
  }

  @media (max-width: 820px) {
    .help-grid,
    .proof-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
