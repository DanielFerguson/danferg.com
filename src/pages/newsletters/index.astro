---
import type SEO from "types/SEO";
import { getCollection } from "astro:content";
import getReadingTime from "reading-time";

import BaseLayout from "@layouts/BaseLayout.astro";
import NavBar from "@components/NavBar.astro";
import ContentList from "@components/ContentList.astro";

const SEO: SEO = {
  title: "2022 newsletter archive | Dan Ferg",
  headline: "2022 newsletters.",
  description:
    "Dan Ferg's 2022 newsletters on building Observer, yFocus, and Mates Motivate in public.",
  imageUrl: "/images/og-default.png",
  openGraph: { type: "website" },
  canonicalUrl: "/newsletters",
  schemaType: "CollectionPage",
  breadcrumbs: [
    { name: "Home", url: "/" },
    { name: "Newsletters", url: "/newsletters" },
  ],
};

const newsletters = (await getCollection("newsletters")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("en-AU", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  }).format(new Date(`${date}T00:00:00`));

const items = newsletters.map((newsletter) => ({
  title: newsletter.data.title,
  description: newsletter.data.description,
  href: newsletter.data.canonicalUrl,
  meta: formatDate(newsletter.data.date),
  detail: getReadingTime(newsletter.body || "").text,
}));

const itemListId = "https://danferg.com/newsletters#itemlist";
const itemListJsonLd = {
  "@type": "ItemList",
  "@id": itemListId,
  name: "Dan Ferg newsletters",
  numberOfItems: items.length,
  itemListOrder: "https://schema.org/ItemListOrderDescending",
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.title,
    url: new URL(item.href, "https://danferg.com").toString(),
  })),
};
---

<BaseLayout {...SEO} mainEntityId={itemListId} jsonLd={itemListJsonLd}>
  <NavBar />

  <main id="main-content">
    <header class="band page-hero-band">
      <div class="band__frame page-hero" data-motion-intro-group>
        <p class="page-hero__eyebrow" data-motion-intro-item>Archive</p>
        <h1 class="page-hero__title" data-motion-intro-item>
          2022 <em>newsletters.</em>
        </h1>
        <p class="page-hero__lede" data-motion-intro-item>
          {newsletters.length} issues written in 2022 while building Observer,
          yFocus, and Mates Motivate in public. The newsletter is wrapped up —
          newer writing lives in <a href="/articles">articles</a>.
        </p>
      </div>
    </header>

    <section class="band band--subtle" aria-label="Newsletter archive">
      <div class="band__frame">
        <ContentList items={items} orderedLabel="All newsletters" />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page-hero__lede a {
    color: var(--signal);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
