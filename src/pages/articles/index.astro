---
import type SEO from "types/SEO";

import BaseLayout from "@layouts/BaseLayout.astro";
import NavBar from "@components/NavBar.astro";
import SectionHeading from "@components/SectionHeading.astro";
import ContentList from "@components/ContentList.astro";
import ArchiveFilters from "@components/ArchiveFilters.astro";
import { loadArchive, tagCounts } from "../../data/article-index";
import { tags as tagCatalogue, tagHref } from "../../data/taxonomy";

const SEO: SEO = {
  title: "Articles on startups, software and social impact | Dan Ferg",
  description:
    "Read Dan Ferg's articles on entrepreneurship, software, startup experiments, burnout, and building useful things. Filter by tag or search every article.",
  imageUrl: "/images/og-default.png",
  openGraph: { type: "website" },
  canonicalUrl: "/articles",
  schemaType: "CollectionPage",
  breadcrumbs: [
    { name: "Home", url: "/" },
    { name: "Articles", url: "/articles" },
  ],
};

const archive = await loadArchive();
const drafts = archive.filter((item) => item.draft);
const items = archive.map(({ date: _date, tags, series, draft: _draft, ...item }) => ({
  ...item,
  tags: tags.map((id) => ({ id, label: tagCatalogue[id].label, href: tagHref(id) })),
  series: series?.id,
}));
const chips = tagCounts(archive);
const itemListId = "https://danferg.com/articles#itemlist";
const publishedItemCount = archive.length - drafts.length;
const itemListJsonLd = {
  "@type": "ItemList",
  "@id": itemListId,
  name: "Dan Ferg articles and research notes",
  numberOfItems: archive.length,
  itemListOrder: "https://schema.org/ItemListOrderDescending",
  itemListElement: archive.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.title,
    url: new URL(item.href, "https://danferg.com").toString(),
  })),
};
---

<BaseLayout {...SEO} mainEntityId={itemListId} jsonLd={itemListJsonLd}>
  <NavBar />
  <main id="main-content" class="site-container archive">
    <p class="breadcrumb"><a href="/">HOME</a> / ARTICLES</p>
    <SectionHeading
      as="h1"
      eyebrow="ARCHIVE_02 // ARTICLES"
      title="Notes from making things."
      description={`${publishedItemCount} essays and research notes on building, learning, burning out, and beginning again.${drafts.length ? ` ${drafts.length} local draft${drafts.length === 1 ? "" : "s"} shown in development only.` : ""}`}
    />
    <ArchiveFilters tags={chips} total={archive.length} live />
    <ContentList items={items} orderedLabel="All articles" />
  </main>
</BaseLayout>

<style>
  .archive {
    padding-block: clamp(2.75rem, 5vw, 4.75rem);
  }

  .breadcrumb {
    margin: 0 0 clamp(2.5rem, 4vw, 4rem);
    color: var(--ink-muted);
    font-size: var(--text-label);
  }

  .breadcrumb a {
    color: var(--ink);
    text-underline-offset: 0.2em;
  }
</style>
