---
import type SEO from "types/SEO";

import BaseLayout from "@layouts/BaseLayout.astro";
import NavBar from "@components/NavBar.astro";
import ContentList from "@components/ContentList.astro";
import ArchiveFilters from "@components/ArchiveFilters.astro";
import { loadArchive, tagCounts } from "../../data/article-index";
import { tags as tagCatalogue, tagHref } from "../../data/taxonomy";

const SEO: SEO = {
  title: "Articles on software and startups | Dan Ferg",
  headline: "Notes from making things.",
  description:
    "Dan Ferg's articles on software, startups, AI, burnout, and lessons from building useful things.",
  imageUrl: "/images/og-default.png",
  openGraph: { type: "website" },
  canonicalUrl: "/articles",
  schemaType: "CollectionPage",
  breadcrumbs: [
    { name: "Home", url: "/" },
    { name: "Articles", url: "/articles" },
  ],
};

const archive = await loadArchive();
const drafts = archive.filter((item) => item.draft);
const items = archive.map(
  ({ date: _date, tags, series, draft: _draft, ...item }) => ({
    ...item,
    tags: tags.map((id) => ({
      id,
      label: tagCatalogue[id].label,
      href: tagHref(id),
    })),
    series: series?.id,
  }),
);
const chips = tagCounts(archive);
const itemListId = "https://danferg.com/articles#itemlist";
const publishedItemCount = archive.length - drafts.length;
const itemListJsonLd = {
  "@type": "ItemList",
  "@id": itemListId,
  name: "Dan Ferg articles and research notes",
  numberOfItems: archive.length,
  itemListOrder: "https://schema.org/ItemListOrderDescending",
  itemListElement: archive.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.title,
    url: new URL(item.href, "https://danferg.com").toString(),
  })),
};
---

<BaseLayout {...SEO} mainEntityId={itemListId} jsonLd={itemListJsonLd}>
  <NavBar />

  <main id="main-content">
    <header class="band page-hero-band">
      <div class="band__frame page-hero" data-motion-intro-group>
        <p class="page-hero__eyebrow" data-motion-intro-item>Writing</p>
        <h1 class="page-hero__title" data-motion-intro-item>
          Notes from <em>making things.</em>
        </h1>
        <p class="page-hero__lede" data-motion-intro-item>
          {publishedItemCount} essays and notes on software, startups, AI, and
          the lessons that show up after launch.{
            drafts.length
              ? ` ${drafts.length} local ${drafts.length === 1 ? "draft" : "drafts"} visible in development.`
              : ""
          }
        </p>
      </div>
    </header>

    <section class="band band--subtle" aria-label="All articles">
      <div class="band__frame">
        <ArchiveFilters tags={chips} total={archive.length} live />
        <ContentList items={items} orderedLabel="All articles" />
      </div>
    </section>
  </main>
</BaseLayout>
