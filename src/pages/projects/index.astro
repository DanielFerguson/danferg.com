---
import type SEO from "types/SEO";
import { getCollection } from "astro:content";

import BaseLayout from "@layouts/BaseLayout.astro";
import NavBar from "@components/NavBar.astro";
import ProjectGrid from "@components/ProjectGrid.astro";
import { compareProjectsByPeriod } from "../../utils/project-sort";

const SEO: SEO = {
  title: "Projects and case studies | Dan Ferg",
  headline: "Things I’ve built.",
  description:
    "Products, client platforms, and side projects Dan Ferg has built — from civic tech and cattle marketplaces to developer tools and games.",
  imageUrl: "/images/og-default.png",
  openGraph: { type: "website" },
  canonicalUrl: "/projects",
  schemaType: "CollectionPage",
  breadcrumbs: [
    { name: "Home", url: "/" },
    { name: "Projects", url: "/projects" },
  ],
};

const projects = (await getCollection("projects"))
  .map((project) => ({
    url: project.data.canonicalUrl,
    frontmatter: project.data,
  }))
  .filter((project) => project.frontmatter.visible !== false)
  .sort(compareProjectsByPeriod);

const itemListId = "https://danferg.com/projects#itemlist";
const itemListJsonLd = {
  "@type": "ItemList",
  "@id": itemListId,
  name: "Dan Ferg project archive",
  numberOfItems: projects.length,
  itemListOrder: "https://schema.org/ItemListOrderDescending",
  itemListElement: projects.map((project, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: project.frontmatter.title,
    url: new URL(project.url, "https://danferg.com").toString(),
  })),
};
---

<BaseLayout {...SEO} mainEntityId={itemListId} jsonLd={itemListJsonLd}>
  <NavBar />

  <main id="main-content">
    <header class="band page-hero-band">
      <div class="band__frame page-hero" data-motion-intro-group>
        <p class="page-hero__eyebrow" data-motion-intro-item>Projects</p>
        <h1 class="page-hero__title" data-motion-intro-item>
          Things I’ve <em>built.</em>
        </h1>
        <p class="page-hero__lede" data-motion-intro-item>
          {projects.length} products, client builds, and side experiments — what
          worked, what didn’t, and what stuck.
        </p>
      </div>
    </header>

    <section class="band band--subtle" aria-label="All projects">
      <div class="band__frame">
        <ProjectGrid projects={projects} />
      </div>
    </section>
  </main>
</BaseLayout>
